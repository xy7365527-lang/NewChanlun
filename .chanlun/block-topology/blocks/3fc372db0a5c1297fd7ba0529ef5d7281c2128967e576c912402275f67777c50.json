      "concepts": [
        {
          "term": "类型",
          "definition": "结晶（crystallization）"
        },
        {
          "term": "状态",
          "definition": "已结算"
        },
        {
          "term": "域",
          "definition": "蜂群治理（governance）、偏差纠正（bias-correction）"
        },
        {
          "term": "\"偏差漫游\"模式（Deviation Wandering）",
          "definition": "在蜂群治理中，当一个维度的偏差被约束封堵后，同一根因（LLM 单 agent 执行倾向）会在约束拓扑的相邻自由度上重新表现。"
        },
        {
          "term": "不可消除性",
          "definition": "根因是 LLM 生成架构的内在特征（020号），不可通过规则消除"
        },
        {
          "term": "可约束性",
          "definition": "每次纠正缩小偏差的表现空间（从\"完全绕过\"到\"打包不当\"）"
        },
        {
          "term": "可预测性",
          "definition": "偏差总是朝\"最小阻力\"的自由度漫游——下一个可能的表现形式是\"蜂群正确但任务粒度不当\"或\"蜂群正确但结构工位空转\""
        },
        {
          "term": "任务粒度过粗",
          "definition": "每个工位的任务描述表面合规但内含多个子任务"
        },
        {
          "term": "结构工位怠惰",
          "definition": "quality-guard/meta-observer 被 spawn 但产出形式化"
        },
        {
          "term": "审查深度不足",
          "definition": "review 节点存在但只做表面检查"
        }
      ],
