      "concepts": [
        {
          "term": "不测而测原则",
          "definition": "退出只根据当前标的自身结构信号。\"B 出现更好机会\"不是 A 的结构事件，用 B 的结构决定 A 的操作违反了只分类当前标的状态的原则"
        },
        {
          "term": "降成本不可逆性",
          "definition": "已积累的成本优势是沉没收益，换仓归零全部降成本进度。卖出后以新价格重新建仓，成本可能更高"
        },
        {
          "term": "合法性审计",
          "definition": "编排者-Claude 推导中进行了审计——卖出 A（结构未失效）进入 B（更好机会），违反缠论\"操作只根据当前标的自身结构\"的原则。审计结论：不合法。"
        },
        {
          "term": "回测框架",
          "definition": "逐 bar 展开，所有判断基于当前已确认的结构。回测应验证：满仓满融下降成本速度、区间套收敛排序的效果、不换仓原则的机会成本"
        },
        {
          "term": "赋格状态机形式化",
          "definition": "赋格定义（第七节）后续需要扩展为状态机，以支持多层嵌套短差和小转大后的循环并存的状态流转"
        },
        {
          "term": "区间套收敛量化",
          "definition": "收敛紧度 = 嵌套层数 x 级别大小 x 各层一致性——这三项的量化方式待定义"
        },
        {
          "term": "赋格定义",
          "definition": "本文档第七节（268-1修复：原引用252号为错误实体，已删除）"
        }
