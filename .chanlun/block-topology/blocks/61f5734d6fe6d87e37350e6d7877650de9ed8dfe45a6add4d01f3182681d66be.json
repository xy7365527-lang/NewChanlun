      "concepts": [
        {
          "term": "语法记录",
          "definition": "将上述已结算原则串联，识别出一条已在运作但未显式化的回路——session 操作序列中的重复模式，经谱系结算后结晶为 skill，skill 注册到 manifest 后被元编排自动加载使用，使用产生新的操作序列。回路不是设计出来的，是五条已结算原则的逻辑必然组合。"
        },
        {
          "term": "谱系自动检测",
          "definition": "post-session hook 扫描操作序列，识别未注册的重复模式，写入 pattern-buffer"
        },
        {
          "term": "结晶自动触发",
          "definition": "谱系节点 settled 且 type=strategy → 自动触发 skill-crystallizer"
        },
        {
          "term": "元编排自动加载",
          "definition": "新 skill 注册到 manifest → 下次 ceremony 自动加载"
        },
        {
          "term": "驱动力",
          "definition": "session 结束（post-session hook）"
        },
        {
          "term": "制动力",
          "definition": "效用背驰——新 skill 效率提升不再覆盖复杂度增加时停止生长（系统的\"第一类卖点\"）"
        },
        {
          "term": "手动结晶（靠 Lead 记得去结晶）",
          "definition": "已失败多次。016号的核心发现——\"知道规则 ≠ 执行规则\"——同样适用于结晶。Lead 知道应该结晶，但在任务压力下会跳过。"
        },
        {
          "term": "手动谱系记录（靠 genealogist 工位手动写入）",
          "definition": "无自动检测机制。重复模式必须被人注意到才能进入谱系，遗漏率高。"
        },
        {
          "term": "静态 skill 系统（预定义所有能力）",
          "definition": "不能生长。020号已结算\"编排能力在 skill 网络中流动\"——静态预定义与此矛盾。"
        }
