      "concepts": [
        {
          "term": "D1（bar → 笔）",
          "definition": "包含处理 + 分型 → 笔只编码方向（up/down），丢弃幅度"
        },
        {
          "term": "D2（笔 → 线段）",
          "definition": "特征序列分型 → 短促振荡被合并，弱方向信号被吸收"
        },
        {
          "term": "D3（线段 → 中枢 → 走势方向）",
          "definition": "中枢 [ZD,ZG] 吸收区间内振荡，走势方向仅由中枢间位置关系决定"
        },
        {
          "term": "幅度耦合携带方向信息",
          "definition": "如果某资产对的幅度共振同时伴随方向同步（如：大涨时同涨，大跌时同跌，小幅时独立），则 D1 不完全吸收，部分幅度耦合可能穿透到离散层面。当前 E-R 数据显示这不成立（β ≈ 0）。"
        },
        {
          "term": "缠论参数改变",
          "definition": "如果笔的间距阈值、中枢的重叠条件等参数改变，ker(D) 的边界会平移。例如更宽松的笔定义（保留更多短促波动）可能使 D1 的幅度吸收减弱。"
        },
        {
          "term": "时间尺度变化",
          "definition": "ker(D) 的结构在不同级别（1分钟/日线/周线）可能不同，因为不同时间尺度下幅度耦合和方向耦合的相对强度可能改变。"
        },
        {
          "term": "非线性耦合",
          "definition": "当前分析假设耦合以线性偏相关度量。强非线性耦合（如尾部依赖）可能在线性度量中被低估，在离散层面显现。"
        },
        {
          "term": "bi.md, xianduan.md, zhongshu.md, qushi.md",
          "definition": "ker(D) 推导的公理来源。"
        },
        {
          "term": "离散化算子 D = D3 ∘ D2 ∘ D1",
          "definition": "缠论管线的形式化抽象"
        },
        {
          "term": "ker(D) = 纯幅度耦合",
          "definition": "缠论离散化的内在选择性原理"
        }
