      "concepts": [
        {
          "term": "可化解的堵塞",
          "definition": "背驰后走势转折，新走势在同一折叠上长出来。D 算子正常运行，背驰-恢复周期在已有拓扑内闭合。"
        },
        {
          "term": "不可化解的堵塞",
          "definition": "所有已有边持续异常 + 新边自发涌现。D 算子的产出模态不再连续——不是某条边背驰，是整个边集的行为模式断裂。"
        },
        {
          "term": "完备性是局部的",
          "definition": "—在给定拓扑上，D 算子 + 完全分类穷尽所有可能"
        },
        {
          "term": "存在是全局的",
          "definition": "—存在不受任何给定拓扑约束，它在拓扑之间运动"
        },
        {
          "term": "语法是永恒的",
          "definition": "—D 算子 + 完全分类的形式在任何拓扑上成立（形式不变，对象变）"
        },
        {
          "term": "对象是历史的",
          "definition": "—拓扑在呼吸，域在诞生和消亡"
        }
