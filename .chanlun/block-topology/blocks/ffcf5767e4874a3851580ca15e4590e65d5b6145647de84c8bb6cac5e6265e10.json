      "concepts": [
        {
          "term": "关键区分",
          "definition": "Gemini 的空间力学类比停在了 Remeshing 层级——承认网格会变，但仍然把\"网格变化\"和\"网格上的求解\"当作两个分离的过程。时空 FEM 的核心是：网格变化和求解是**同一个**时空过程的两个方面。这与 292号折叠生命周期的核心命题一致——折叠不是走势的静态背景，折叠和走势同时演化。"
        },
        {
          "term": "时空 FEM 对应",
          "definition": "—折叠生命周期的数学结构不是标准 FEM（固定网格），是时空 FEM（网格和解同时演化）"
        },
        {
          "term": "FEM 四层级对应",
          "definition": "—标准 FEM / AMR / Remeshing / 时空 FEM 对应折叠生命周期四阶段"
        },
        {
          "term": "利润率均等化 = 变分原理",
          "definition": "—资本运动的驱动力（利润率差异）对应 FEM 变分问题的泛函梯度"
        },
        {
          "term": "拓扑变化 = 泛函形式改变",
          "definition": "—折叠重新结算期不仅解变，泛函本身也变"
        },
        {
          "term": "主体位置 FEM 翻译",
          "definition": "—拓扑不变量 = 基函数集合，度量自由度 = 权重分配，决断 = 选择权重"
        },
        {
          "term": "298号 (Gemini) 空间力学类比",
          "definition": "从\"空间离散\"扩展为\"时空离散\"——补完时间维度"
        },
        {
          "term": "298号 (Gemini) 主体位置",
          "definition": "从\"凝视受力图的工程师\"（外在观察者）降级为\"拓扑不变量与度量自由度之间的裂隙\"（内在结构位置）"
        }
