+            gross: f64, net: f64,             // NEST_CONS 杠杆峰值
+            fills: u64, cost_paid: f64, consumes: u64, liq: u64,
+        }
+        let mut rows: Vec<Row> = Vec::new();
+        eprintln!("\n===== friction-model L3：OFF/ANCHOR/NEST_CONS × (cost0/costReal)（Structural）=====");
+
