+    /// 跑法：`BT_SYMBOLS=ES,QQQ cargo test --release recursive_t::rec_stream::tests::prop4_readingb_friction_l3 -- --exact --ignored --nocapture`
+    #[test]
+    #[ignore = "friction-model reading_b L3，需 analysis/data_cache/*.json"]
+    fn prop4_readingb_friction_l3() {
+        use super::super::rec_engine::EngineConfig;
+        use crate::recursive_t::backtest_run::{load_clean_ohlc, SYMBOLS};
+        use std::path::PathBuf;
+
+        let cost_of = |sym: &str| -> f64 {
+            if let Ok(v) = std::env::var("T_COST_BPS").map(|s| s.parse::<f64>().unwrap_or(0.0)) {
+                if v > 0.0 { return v; }
+            }
+            match sym {
+                "CL" => 1.0, "BRN" => 1.5, "DX" => 1.0, "GC" => 1.0,
+                "ES" => 0.75, "QQQ" => 0.75, "BTC" => 5.0, "OKLO" => 10.0,
+                _ => 1.0,
+            }
+        };
+        let data_dir = PathBuf::from(env!("CARGO_MANIFEST_DIR")).parent().unwrap().join("analysis/data_cache");
+        let only: Vec<String> = std::env::var("BT_SYMBOLS").ok()
+            .map(|s| s.split(',').map(|x| x.trim().to_uppercase()).filter(|x| !x.is_empty()).collect())
+            .unwrap_or_default();
+
+        struct Row {
+            sym: String, bh: f64, costbps: f64,
+            div0: f64, divc: f64, gross: f64, net: f64, mean_gross: f64, mean_net: f64,
+            fills: u64, cost_paid: f64, liq: u64,
+        }
+        let mut rows: Vec<Row> = Vec::new();
+        eprintln!("\n===== friction-model reading_b L3：RB_DIVERGE × (cost0/costReal)（Structural）=====");
+
+        for (sym, file) in SYMBOLS {
+            if !only.is_empty() && !only.contains(&sym.to_uppercase()) { continue; }
+            let path = data_dir.join(file);
+            if !path.exists() { eprintln!("[{sym}] 数据缺失，跳过"); continue; }
+            let (o, h, l, c) = load_clean_ohlc(&path);
+            let n = c.len();
+            let bh = if n > 0 && c[0] > 0.0 { (c[n - 1] / c[0] - 1.0) * 100.0 } else { 0.0 };
+            let cb = cost_of(sym);
+
+            let run = |cfg: EngineConfig| -> (f64, f64, f64, f64, f64, u64, f64, u64) {
+                let mut s = RecStream::new_with_config(PerfectionMode::Structural, A0Source::Segment, cfg);
+                for i in 0..n { s.push_bar(o[i], h[i], l[i], c[i]); }
+                let fin = s.finish();
+                let r = s.driver().root();
+                let samp = r.exp_samples.max(1) as f64;
+                (
+                    (fin / INITIAL_CAPITAL - 1.0) * 100.0,
+                    r.max_gross_exp_x100 as f64 / 100.0,
+                    r.max_net_exp_x100 as f64 / 100.0,
+                    r.exp_gross_sum_x100 / samp / 100.0,
+                    r.exp_net_sum_x100 / samp / 100.0,
+                    r.n_fills, r.total_cost_paid, r.n_liquidations,
+                )
+            };
+
+            let t0 = std::time::Instant::now();
+            let mut d0 = EngineConfig::reading_b_diverge(); d0.cost_bps_per_side = 0.0;
+            let (div0, g0, nt0, mg0, mn0, _f0, _cp0, _lq0) = run(d0);
+            let mut dR = EngineConfig::reading_b_diverge(); dR.cost_bps_per_side = cb;
+            let (divc, gR, ntR, _mgR, _mnR, fR, cpR, lqR) = run(dR);
+
+            eprintln!(
+                "[{sym:<5}] BH={:+.1}% | RB_DIVERGE cost0={:+.1}% costR({:.2}bps)={:+.1}% | maxGross={:.2}× maxNet={:.2}× \
+                 meanGross={:.2}× meanNet={:.2}× | fills={} cost_paid=${:.0} liq={} ({:.0}s)",
+                bh, div0, cb, divc, g0.max(gR), nt0.max(ntR), mg0, mn0, fR, cpR, lqR, t0.elapsed().as_secs_f64()
+            );
+            rows.push(Row {
+                sym: sym.to_string(), bh, costbps: cb, div0, divc,
+                gross: g0.max(gR), net: nt0.max(ntR), mean_gross: mg0, mean_net: mn0,
+                fills: fR, cost_paid: cpR, liq: lqR,
+            });
+        }
+
+        println!("\n===== friction-model reading_b L3 矩阵（* 超 BH；levadj_pk=costR/max_net 下界, levadj_mn=costR/mean_net）=====");
+        println!("{:<6} {:>10} {:>13} {:>13} {:>8} {:>8} {:>9} {:>9} {:>11} {:>11}",
