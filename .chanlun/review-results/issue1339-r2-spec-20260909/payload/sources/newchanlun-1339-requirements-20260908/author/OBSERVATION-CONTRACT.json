  "requirements": [
    {
      "id": "OB-001",
      "topic": "观察范围与来源",
      "requirement": "每次查询、快照和变化均绑定标的、数据来源与输入版本、规则版本、运行模式、会话及代际、观察视角和请求覆盖范围。",
      "proposed_payload_or_surface": "scope、instrument/source、input_revision、rules_revision、run/session/generation、view、mode；名称为草案。",
      "acceptance_scenario": "同一标的的历史回放与实时观察同时打开，任何旧会话消息不能改写另一会话；切换视角不会串用旧对象。",
      "counterexample": "跨会话/跨数据源同名标的仅靠symbol匹配。",
