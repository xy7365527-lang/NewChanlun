+                old.1,
+                actual.1,
+                old.2,
+                actual.2,
+                roots(&old.3),
+                roots(&actual.3)
+            );
+            assert_eq!(roots(&actual.3), 1, "None 同一局部根只批读一次");
+            assert!(actual.1 < old.1, "必须减少真实SQL读取");
+            assert_eq!(actual.2, actual.1, "每个实际节点读仍核本次F");
+        }
+    }
