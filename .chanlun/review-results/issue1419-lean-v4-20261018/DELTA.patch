+  unfold Contains at h
+  have h1 : ¬ x.low < b.low := by (try simp only [Tick] at *); omega
+  have h2 : ¬ b.high < x.high := by (try simp only [Tick] at *); omega
+  simp only [turnWindowStateDown, if_neg h1, if_neg h2]
