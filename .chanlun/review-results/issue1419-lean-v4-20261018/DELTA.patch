+    FirstBreakConfirmsDown a b c ∧ ¬ IsBottomFractal a b c := by
+  unfold FirstBreakConfirmsDown IsBottomFractal
+  exact ⟨⟨h1, by (try simp only [Tick] at *); omega, h3⟩, fun ⟨_, h⟩ => by (try simp only [Tick] at *); omega⟩
