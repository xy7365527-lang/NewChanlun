+  def listInterval : List Move → (Int × Int)
+    | [] => (0, 0)
+    | [m] => interval m
+    | m :: m' :: ms =>
+        let a := interval m
+        let b := listInterval (m' :: ms)
+        (min a.1 b.1, max a.2 b.2)
