+/// 紧凑全量重建（生产 `parse_layer` 同一路径）：`IncrFactsState` 折叠 + 唯一 transition。
+fn compact_full(bars: &[Bar], config: &ParseConfig) -> StrokeFacts {
+    let mut state = IncrFactsState::empty();
+    for bar in bars {
+        state.append(*bar);
+    }
+    build_stroke_facts_with_positions(
+        state.merged_slice(),
+        state.groups_slice(),
+        state.unsettled(),
+        state.positions(),
+        config,
+    )
+}
