+/// 终点极值根末项（成员闭区间的上界；与首根一样拒绝空集及坐标溢出）。
+fn last_extreme_root(endpoint: &Endpoint) -> Result<i64, BiError> {
+    endpoint
+        .extreme_roots
+        .last()
+        .map(|root| coord_i64(*root))
+        .transpose()?
+        .ok_or_else(|| BiError::Facts {
+            detail: format!(
+                "端点 {} 没有极值根，无法定位关系成员区间",
+                endpoint.group_anchor
+            ),
+        })
+}
