+/// 末笔改写：同向延伸前的暂态（末笔终点回缩到半程，至少 1 tick）。
+fn wobble_tail(ss: &[Stroke]) -> Vec<Stroke> {
+    let mut w = ss.to_vec();
+    if let Some(last) = w.last_mut() {
+        let back = ((last.end_price - last.start_price).abs() / 2).max(1);
+        last.end_price += match last.direction {
+            Direction::Up => -back,
+            Direction::Down => back,
+        };
+    }
+    w
+}
