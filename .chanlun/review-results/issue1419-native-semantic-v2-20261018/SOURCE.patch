+        assert!(f.outer_touch() && !f.core_tangent());
+        // W7：A=(10,20,35,50) B=(5,42,48,60)：B 外缘包含 A 外缘，向上扩展。
+        let f = center_pair_facts(&center(10, 20, 35, 50), &center(5, 42, 48, 60));
