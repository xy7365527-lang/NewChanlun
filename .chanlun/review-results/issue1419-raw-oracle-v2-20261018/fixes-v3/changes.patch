+        if not p.is_file() or str(p.relative_to(ROOT)) in ('MANIFEST.json','SHA256SUMS'):continue
+        b=p.read_bytes();entries.append(dict(path=str(p.relative_to(ROOT)),bytes=len(b),sha256=digest(b)))
