{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "#1419 v5候选与离线绑定合同",
  "type": "object",
  "required": [
    "schema",
    "authorization",
    "execution_authorized",
    "source_commit",
    "source_tree",
    "binary_sha256",
    "product_run",
    "watch_contract"
  ],
  "properties": {
    "schema": {
      "const": "issue1419-raw-driver-contract/5"
    },
    "authorization": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "source_commit": {
      "const": "PENDING_SOURCE"
    },
    "source_tree": {
      "const": "PENDING_SOURCE"
    },
    "binary_sha256": {
      "const": "PENDING_SOURCE"
    },
    "product_run": {
      "const": "NOT_RUN"
    },
    "watch_contract": {
      "const": {
        "trusted_anchor": "调用者已验证的完整快照固定切面；本离线函数不能证明来源，禁止用首代accepted_cut自签",
        "stable_fields": [
          "session_id",
          "session_generation",
          "catalog_revision",
          "profile_id",
          "profile_hash",
          "scope",
          "rule_revision",
          "history_mode"
        ],
        "per_generation_fields": [
          "structure_cut",
          "cut_generation",
          "index_frontier",
          "input_frontier",
          "seq_range",
          "catalog_run_status",
          "catalog_evidence",
          "as_of_generation"
        ],
        "per_generation_rule": "结构cut/代际/index/input/seq/status/evidence逐字段匹配delta；as_of_generation匹配当前generation；input_frontier差值等于具名accepted_events。catalog_evidence是逐代证据，不冻结它的内容根",
        "failure": "整次watch调用原子保留此前已验证状态；先前其他成功调用仍保留；逻辑工作和累计回复费用不回滚",
        "lifecycle": "UNVERIFIED",
        "formal_wire_binding": "PENDING_SOURCE"
      }
    }
  },
  "$defs": {
    "public_tested_object": {
      "type": "object",
      "required": [
        "kind",
        "payload"
      ],
      "not": {
        "required": [
          "payload_json"
        ]
      },
      "properties": {
        "kind": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/public_payload_value"
              }
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/public_payload_value"
          }
        }
      },
      "description": "schema描述普通JSON形状；0x07必须由driver在plain前对原始s-content类型检查，不能靠序列化后的schema证明"
    },
    "accepted_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_generation",
        "message_id",
        "source_epoch",
        "accepted_events",
        "accepted_cut"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "session_generation": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "source_epoch": {
          "type": "string"
        },
        "accepted_events": {
          "type": "string"
        },
        "accepted_cut": {
          "type": "object",
          "required": [
            "session_id",
            "session_generation",
            "structure_cut",
            "cut_generation",
            "catalog_revision",
            "index_frontier",
            "profile_id",
            "profile_hash",
            "input_frontier",
            "seq_range",
            "catalog_run_status",
            "catalog_evidence",
            "scope",
            "rule_revision",
            "history_mode",
            "as_of_generation"
          ],
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "type": "string"
            },
            "session_generation": {
              "type": "string"
            },
            "structure_cut": {
              "type": "string"
            },
            "cut_generation": {
              "type": "string"
            },
            "catalog_revision": {
              "type": "string"
            },
            "index_frontier": {
              "type": "string"
            },
            "profile_id": {
              "type": "string"
            },
            "profile_hash": {
              "type": "string"
            },
            "input_frontier": {
              "type": "string"
            },
            "seq_range": {
              "type": "object"
            },
            "catalog_run_status": {
              "type": "string"
            },
            "catalog_evidence": {
              "type": "object"
            },
            "scope": {
              "type": "object"
            },
            "rule_revision": {
              "type": "string"
            },
            "history_mode": {
              "type": "string"
            },
            "as_of_generation": {
              "type": "string"
            }
          }
        }
      }
    },
    "public_payload_value": {
      "description": "原始内容树不得含json_text。Number保留原始数值令牌直到显式转换；本递归schema不是原始tag验证器。",
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "string",
            "number"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/public_payload_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/public_payload_value"
          }
        }
      ]
    },
    "watch_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_generation",
        "base_cut",
        "catalog_revision",
        "index_frontier",
        "last_seq",
        "order_version",
        "scope",
        "session_generation",
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "session_generation": {
          "type": "string"
        },
        "catalog_revision": {
          "type": "string"
        },
        "scope": {
          "type": "object"
        },
        "after_generation": {
          "type": "string"
        },
        "base_cut": {
          "type": "string"
        },
        "index_frontier": {
          "type": "string"
        },
        "last_seq": {
          "type": "string"
        },
        "order_version": {
          "type": "string"
        }
      }
    },
    "watch_context": {
      "type": "object",
      "required": [
        "trusted_fixed",
        "last_verified_fixed",
        "last_verified_cursor"
      ],
      "properties": {
        "trusted_fixed": {
          "$ref": "#/$defs/accepted_binding/properties/accepted_cut"
        },
        "last_verified_fixed": {
          "$ref": "#/$defs/accepted_binding/properties/accepted_cut"
        },
        "last_verified_cursor": {
          "$ref": "#/$defs/watch_cursor"
        }
      },
      "description": "运行时由Collector私有状态持有；不接受调用者重置，预算独立于状态的成功/失败一直累计"
    }
  }
}
