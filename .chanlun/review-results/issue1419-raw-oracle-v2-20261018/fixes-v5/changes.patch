+                    result = 200, headers, reply(json.loads(raw), {'ok':True})
+                    clock[0] = expired
+                    return result
+                c = collector(exchange, 300, check)
+                error = None
+                original = fd.canonical
+                def guarded(value):
+                    if isinstance(value, dict) and value.get('headers') is headers:
+                        self.assertIn(name, ('empty','small'))
+                        self.assertFalse(expired)
+                    return original(value)
+                with patch.object(Path, 'write_bytes', side_effect=lambda b:writes.append(len(b))), \
