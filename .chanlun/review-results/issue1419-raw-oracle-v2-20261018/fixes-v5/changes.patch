+def watch_material(frontiers=('139', '204', '269'), counts=(1, 65, 65)):
+    fixed = fixture()[0]['fixed_cut']
+    cursor = {k:copy.deepcopy(fixed[k]) for k in
+              ('session_id', 'session_generation', 'catalog_revision', 'scope', 'index_frontier')}
+    cursor.update(after_generation='139', base_cut='toy-cut', last_seq='138', order_version='s-record-order/2')
+    current = copy.deepcopy(cursor)
+    pages, bindings = [], {}
+    for i, (frontier, count) in enumerate(zip(frontiers, counts), 140):
+        cut = dict(copy.deepcopy(fixed), cut_generation=str(i), structure_cut='cut-'+str(i),
+                   input_frontier=frontier, index_frontier=str(i), as_of_generation=str(i),
+                   seq_range={'from':'7', 'to':'7'})
+        delta = dict(generation=str(i), session_id='toy', catalog_revision=cut['catalog_revision'],
+                     base_cut=current['base_cut'], next_cut=cut['structure_cut'],
+                     **{k:copy.deepcopy(cut[k]) for k in ('index_frontier','input_frontier','seq_range',
+                                                          'catalog_run_status','catalog_evidence')}, delta={})
+        current.update(after_generation=str(i), base_cut=delta['next_cut'],
+                       index_frontier=str(i), last_seq=frontier)
+        bindings[str(i)] = dict(session_id='toy', session_generation='1', message_id='named-'+str(i),
+                                source_epoch='1' if i == 140 else '2', accepted_events=str(count), accepted_cut=cut)
+        pages.append(dict(deltas=[delta], next_cursor=copy.deepcopy(current), observed_head=str(i),
+                          delivery_frontier=str(i), has_more=False, gap=None,
+                          validated_capture_digest='b'*64, ok=True))
+    return fixed, cursor, pages, bindings
+
+
+def bind(c, fixed, cursor):
+    if hasattr(c, 'bind_watch'):
+        c.bind_watch(fixed, cursor)
