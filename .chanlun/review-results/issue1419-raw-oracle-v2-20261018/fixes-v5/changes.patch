+    def test_f2_metadata_admission_shapes_deadline_and_cumulative(self):
+        shapes = {'empty':{}, 'small':{'x-toy':''}, 'value':{'x-toy':'x'*2000000},
+                  'key':{'x'*2000000:''}, 'nested':{'x-toy':[{'inner':'x'*2000000}]},
+                  'fragments':{'x-toy':['x'*1000]*2000}, 'integer':{'x-toy':1<<2000000}}
+        for name, headers in shapes.items():
+            for expired in (False, True):
+                clock = [False]
+                calls, writes = [], []
+                def check():
+                    calls.append(clock[0])
+                    if clock[0]:
+                        raise ValueError('总截止已到')
+                def exchange(route, raw):
+                    result = 200, headers, reply(json.loads(raw), {'ok':True})
+                    clock[0] = expired
+                    return result
+                c = collector(exchange, 300, check)
+                error = None
+                original = fd.canonical
+                def guarded(value):
+                    if isinstance(value, dict) and value.get('headers') is headers:
+                        self.assertIn(name, ('empty','small'))
+                        self.assertFalse(expired)
+                    return original(value)
+                with patch.object(Path, 'write_bytes', side_effect=lambda b:writes.append(len(b))), \
+                     patch.object(fd, 'canonical', side_effect=guarded):
+                    try:
+                        c.call('/toy', {})
+                    except ValueError as e:
+                        error = str(e)
+                ok = name in ('empty','small') and not expired
+                self.assertEqual(error is None, ok)
+                self.assertEqual(len(writes), 3 if ok else 1)
+                self.assertLessEqual(c.work_budget.used, 300)
+                if expired:
