+def collector(exchange=lambda *_: None, limit=1000000, check=lambda: None):
+    clock = fd.Budget(16*1024*1024, 10)
+    work = cc.WorkBudget(limit, check)
+    # 仅兼容固定 v4 的红测入口；v5 正测会断言正式构造必须接工作预算。
+    kw = {'work_budget': work} if 'work_budget' in inspect.signature(fd.Collector).parameters else {}
+    with patch.object(Path, 'mkdir'):
+        c = dv.CollectorV2(IDENTITY, clock, exchange, Path('/memory/trace'), '1', **kw)
+    if not kw:
+        c.work_budget = work
+    return c
