+        accepted, error = [], None
+        for page in pages:
+            generation = int(page['deltas'][0]['generation'])
+            with patch.object(c, 'call', return_value=page):
+                try:
+                    result = c.watch(cursor, generation, 'client', accepted_commits=bindings)
+                except ValueError as e:
+                    error = str(e)
+                    break
+            cursor = result['next_cursor']
+            accepted.append(generation)
+        OBS.append(dict(case='F8分次profile漂移', accepted=accepted, error=error))
+        self.assertEqual(accepted, [140])
+        self.assertIn('身份', error)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
