+        self.calls = 0
+        self.headers = {}
+        self.transform = lambda payload: payload
+        self.fail_on = None
+        self.log = []
+
+    def use(self, m):
+        self.material = m
+        self.sent = False
+
+    def __call__(self, route, raw):
+        self.calls += 1
