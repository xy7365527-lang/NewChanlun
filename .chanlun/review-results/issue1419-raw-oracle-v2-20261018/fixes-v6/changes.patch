{\"after_generation\":\"140\",\"base_cut\":\"cut-140\",\"catalog_revision\":\"toy-catalog\",\"index_frontier\":\"140\",\"last_seq\":\"139\",\"order_version\":\"s-record-order/2\",\"scope\":{\"economic\":\"not_started\",\"structure\":\"CompleteCut\"},\"session_generation\":\"1\",\"session_id\":\"toy\"},\"observed_head\":{\"as_of_generation\":null,\"catalog_evidence\":{\"extent\":\"1\",\"format\":\"s-content/1\",\"kind\":\"object\",\"root\":\"sc1-15945506c1bcf630121a1b5aa39bb053043df1044b6964287b1c0b57f5cfba10\"},\"catalog_revision\":\"toy-catalog\",\"catalog_run_status\":\"complete\",\"cut_generation\":\"140\",\"history_mode\":\"RecomputedWithRevision\",\"index_frontier\":\"140\",\"input_frontier\":\"139\",\"profile_hash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"profile_id\":\"toy-profile\",\"rule_revision\":\"TOY_ONLY\",\"scope\":{\"economic\":\"not_started\",\"structure\":\"CompleteCut\"},\"seq_range\":{\"from\":\"7\",\"to\":\"7\"},\"session_generation\":\"1\",\"session_id\":\"toy\",\"structure_cut\":\"cut-140\"},\"ok\":true,\"validated_capture_digest\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"},\"payload_hash\":\"b39db015014db1a1e04769f278c5449a99d229f23aff1a88c163f095e77f952b\",\"producer_epoch\":\"1\",\"producer_id\":\"Q:toy\",\"schema_revision\":\"s-session/3\",\"session_generation\":\"1\",\"session_id\":\"toy\",\"source_epoch\":\"1\",\"source_namespace\":\"s-observe/replies\"}"}]}
