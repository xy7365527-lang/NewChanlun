+def state_control(seeds):
+    """八条接口消息；只用回放已捕获状态，不step新行情、不创造proposal。"""
+    m,anchors=seeds[122];n,_=seeds[138]
+    p=copy.deepcopy(m.previous_active);assert p['start']==117 and p['end']==121
+    original_versions=copy.deepcopy(m.versions);original_confirmed=copy.deepcopy(m.confirmed)
+    trace=[]
+    fields=('endpointKnownAt','terminalCandidate','frozenL','wholeFrozenL','cFrozenL','frozenAt','rawEvidenceKnownAt','pendingTerminalPen','pendingTerminalKnownAt')
+    def state(which):
+        return {'raw5':copy.deepcopy(which.raw[5]),'P0':copy.deepcopy(which.wholes['P0']),
+                'stableCount':len(which.stable),'versionCount':len(which.versions),'priceCount':len(which.prices)}
+    def record(kind,which,**extra):trace.append({'message':len(trace)+1,'kind':kind,'state':state(which),**extra})
+    # 1. Existing tentative endpoint receives an actual interface withdrawal notification.
+    before=state(m);m.withdraw_active(p,122,'control-withdrawal-not-market-history')
+    for obj in (m.raw[5],m.wholes['P0']):assert obj['end'] is None and all(f not in obj for f in fields)
+    assert m.confirmed==original_confirmed and m.versions==original_versions
+    record('withdraw-existing-tentative-terminal',m,before=before,cleared_current_fields=['end','endpointKnownAt','terminalCandidate'],
+           absent_dependency_fields_checked=['frozenL','wholeFrozenL','cFrozenL','frozenAt','rawEvidenceKnownAt'])
+    # 2. Coordinates already observed at cut122, but no proposal with this same start/end exists.
+    replacement={**p,'end':122,'end_price':m.prices[122]}
+    assert key(replacement) not in m.lookup
+    assert not m.observe_active(replacement,122,anchors)
+    for obj in (m.raw[5],m.wholes['P0']):
+        assert not m.bind_terminal(obj,replacement,122)
+        assert obj['end'] is None and 'terminalCandidate' not in obj and obj['state']=='pending-unrepresented-terminal'
+    assert m.versions==original_versions
+    record('unrepresented-active-notification',m,notification=replacement,proposal_backfilled=False,
+           semantics='API identity notification only; this endpoint is not asserted to be a valid market fractal')
+    # 3. Withdrawal also cancels unrepresented pending-terminal references.
+    m.withdraw_active(replacement,122,'control-withdraw-unrepresented')
+    for obj in (m.raw[5],m.wholes['P0']):assert obj['end'] is None and all(f not in obj for f in fields)
+    record('withdraw-unrepresented-terminal',m)
+    # 4. Re-admit only the genuinely existing historical proposal, without inventing past versions.
+    assert m.observe_active(p,122,anchors)
+    for obj in (m.raw[5],m.wholes['P0']):assert m.bind_terminal(obj,p,122) and obj['end']==121
+    assert m.confirmed==original_confirmed and m.versions==original_versions
+    record('reactivate-existing-proposal-and-rebind',m,proposal=m.lookup[key(p)])
+    # 5. Reuse the actual certificate knownAt126; this is a state acknowledgement, not four new prices.
