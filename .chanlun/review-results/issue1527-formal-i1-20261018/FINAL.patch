+#[derive(Clone, Copy, PartialEq, Eq)]
+struct FileStamp {
+    identity: Identity,
+    size: u64,
+    mtime: (i64, i64),
+    ctime: (i64, i64),
+    nlink: u64,
+    kind: u32,
+}
+
+impl FileStamp {
+    fn of(meta: &Metadata) -> Self {
+        Self {
+            identity: Identity::of(meta),
+            size: meta.size(),
+            mtime: (meta.mtime(), meta.mtime_nsec()),
+            ctime: (meta.ctime(), meta.ctime_nsec()),
+            nlink: meta.nlink(),
+            kind: meta.mode() & libc::S_IFMT as u32,
+        }
+    }
+}
+
+struct PinnedDirectory {
+    file: File,
+    identity: Identity,
+}
+
+impl PinnedDirectory {
+    fn new(file: File) -> io::Result<Self> {
+        let meta = file.metadata()?;
+        if !meta.is_dir() {
+            return Err(io::Error::from(io::ErrorKind::InvalidData));
+        }
+        Ok(Self {
+            file,
+            identity: Identity::of(&meta),
+        })
+    }
+
+    fn matches(&self, candidate: &File) -> bool {
+        let same = |file: &File| {
+            file.metadata()
+                .map(|meta| meta.is_dir() && Identity::of(&meta) == self.identity)
+                .unwrap_or(false)
+        };
+        same(&self.file) && same(candidate)
+    }
+}
+
+struct PinnedControl {
+    file: File,
+    stamp: FileStamp,
+    // 原字节仅保存在私有字段；复核只比元数据，不解析替身、不重新签发。
+    _raw: Vec<u8>,
+}
+
+impl PinnedControl {
+    fn matches(&self, candidate: &File) -> bool {
+        let same = |file: &File| {
+            file.metadata()
+                .map(|meta| FileStamp::of(&meta) == self.stamp)
+                .unwrap_or(false)
+        };
+        same(&self.file) && same(candidate)
+    }
+}
