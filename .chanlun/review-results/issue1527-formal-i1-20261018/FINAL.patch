+//! #1527：从 #1504 b9f38106 的固定 FD VFS 适配；只读 main/WAL，非默认注册。
+//! 外层 WriterScope 持真实双锁；本层虚拟锁仅维护私有 SQLite 连接状态。
+//! SAFETY 总契约：SQLite 给出的回调指针/缓冲区须符合其 C API；非默认注册对象
+//! 地址稳定，Registration 活至所有 Connection/Statement/file 关闭之后；不导出裸 handle。
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use super::IoAccounting;
+use rusqlite::{config::DbConfig, ffi, Connection, OpenFlags};
+use serde::Serialize;
+use std::cell::RefCell;
+use std::ffi::{c_char, c_int, c_void, CStr, CString};
+use std::fs::File;
+use std::marker::PhantomData;
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::{FileExt, MetadataExt};
+use std::ptr;
+use std::rc::Rc;
+use std::sync::atomic::{AtomicBool, AtomicI32, AtomicU64, AtomicUsize, Ordering};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+pub type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+pub const EXPECTED_SOURCE_ID: &str =
+    "2026-06-03 19:12:13 d6e03d8c777cfa2d35e3b60d8ec3e0187f3e9f99d8e2ee9cac695fd6fcdf1a24";
+const MAIN: i32 = 1;
+const WAL: i32 = 2;
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum Fault {
+    OpenNoMem = 1,
+    ReadIo = 2,
+    ReadPanic = 3,
+    ReadShort = 4,
+    ReadInterrupted = 5,
+    CloseIo = 6,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct Identity {
+    dev: u64,
+    ino: u64,
+    len: u64,
+    nlink: u64,
+    mtime: i64,
+    mtime_nsec: i64,
+    uid: u32,
+    mode: u32,
+    ctime: i64,
+    ctime_nsec: i64,
+    readonly_fd: bool,
+}
+
+struct Source {
+    file: File,
+    identity: Identity,
+}
+
+impl Source {
+    fn identity(file: &File) -> std::io::Result<Identity> {
+        let m = file.metadata()?;
+        // SAFETY: F_GETFL 只查询活着的 File 所拥有的 FD。
+        let flags = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        if !m.is_file() || m.nlink() != 1 || flags & libc::O_ACCMODE != libc::O_RDONLY {
+            return Err(std::io::Error::other(
+                "source is not a single-link O_RDONLY regular file",
+            ));
+        }
+        Ok(Identity {
+            dev: m.dev(),
+            ino: m.ino(),
+            len: m.len(),
+            nlink: m.nlink(),
+            mtime: m.mtime(),
+            mtime_nsec: m.mtime_nsec(),
+            uid: m.uid(),
+            mode: m.mode(),
+            ctime: m.ctime(),
+            ctime_nsec: m.ctime_nsec(),
+            readonly_fd: true,
+        })
+    }
+
+    fn pin(file: File) -> Result<Self> {
+        let identity = Self::identity(&file)?;
+        if identity.len > i64::MAX as u64 {
+            return Err("source too large".into());
+        }
+        Ok(Self { file, identity })
+    }
+
+    fn unchanged(&self) -> bool {
+        Self::identity(&self.file).is_ok_and(|now| now == self.identity)
+    }
+}
+
+struct Context<'a> {
+    account: RefCell<&'a mut dyn IoAccounting>,
+    main: Source,
+    wal: Option<Source>,
+    main_name: CString,
+    wal_name: CString,
+    journal_name: CString,
+    shm_name: CString,
+
+    trace_overflow: AtomicBool,
+    main_open: AtomicBool,
+    wal_open: AtomicBool,
+    active: AtomicUsize,
+    exclusive_armed: AtomicBool,
+    fault: AtomicI32,
+    caught_panics: AtomicUsize,
+    close_errors: AtomicUsize,
+    sql_denials: AtomicUsize,
+    read_bytes: AtomicU64,
+    retries: AtomicUsize,
+}
+
+impl Context<'_> {
+    fn source(&self, kind: i32) -> Option<&Source> {
+        match kind {
+            MAIN => Some(&self.main),
+            WAL => self.wal.as_ref(),
+            _ => None,
+        }
+    }
+    fn take_fault(&self, f: Fault) -> bool {
+        self.fault
+            .compare_exchange(f as i32, 0, Ordering::SeqCst, Ordering::SeqCst)
+            .is_ok()
+    }
+    fn record(&self, _op: &'static str, _kind: i32, _a: i64, _b: i64, rc: i32) -> i32 {
+        // 不保留逐回调轨迹，不把原型 trace cap 变成生产帽。
+        rc
+    }
+    fn before_io(&self) -> bool {
+        self.account
+            .try_borrow_mut()
+            .is_ok_and(|mut a| a.before_io().is_ok())
+    }
+    fn after_read(&self, n: u64) -> bool {
+        self.account
+            .try_borrow_mut()
+            .is_ok_and(|mut a| a.after_read(n).is_ok())
+    }
+}
+
+#[repr(C)]
+struct PinnedFile {
+    base: ffi::sqlite3_file, // SQLite 的首字段布局；SQLite 分配 szOsFile 字节。
+    ctx: *const c_void,
+    kind: i32,
+    lock: i32,
+}
+
+// SAFETY: 仅 SQLite 在本注册对象存活期间调用；pAppData 是稳定 Box<Context>。
+unsafe fn context<'a>(vfs: *mut ffi::sqlite3_vfs) -> &'a Context<'a> {
+    unsafe { &*((*vfs).pAppData.cast::<Context>()) }
+}
+
+// 每个 C ABI 的有状态路径都在此捕获 Rust unwind；OOM-abort/OS kill 不伪装成可捕获。
+fn guarded(ctx: &Context, f: impl FnOnce() -> i32) -> i32 {
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)) {
+        Ok(rc) => rc,
+        Err(_) => {
+            ctx.caught_panics.fetch_add(1, Ordering::SeqCst);
+            ffi::SQLITE_IOERR
+        }
+    }
+}
+
+unsafe fn bytes<'a>(name: *const c_char) -> Option<&'a [u8]> {
+    if name.is_null() {
+        None
+    } else {
+        Some(unsafe { CStr::from_ptr(name) }.to_bytes())
+    }
+}
+
+unsafe extern "C" fn open(
+    vfs: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    out: *mut ffi::sqlite3_file,
+    flags: c_int,
+    out_flags: *mut c_int,
+) -> c_int {
+    // SAFETY: SQLite 提供对齐且可写的 szOsFile 存储。失败初始 pMethods=NULL。
+    unsafe {
+        (*out).pMethods = ptr::null();
+    }
+    if !out_flags.is_null() {
+        unsafe {
+            *out_flags = 0;
+        }
+    }
+    let ctx = unsafe { context(vfs) };
+    guarded(ctx, || {
+        let name = unsafe { bytes(name) };
+        let types = ffi::SQLITE_OPEN_MAIN_DB
+            | ffi::SQLITE_OPEN_TEMP_DB
+            | ffi::SQLITE_OPEN_TRANSIENT_DB
+            | ffi::SQLITE_OPEN_MAIN_JOURNAL
+            | ffi::SQLITE_OPEN_TEMP_JOURNAL
+            | ffi::SQLITE_OPEN_SUBJOURNAL
+            | ffi::SQLITE_OPEN_SUPER_JOURNAL
+            | ffi::SQLITE_OPEN_WAL;
+        let kind = if name == Some(ctx.main_name.as_bytes())
+            && flags & types == ffi::SQLITE_OPEN_MAIN_DB
+            && flags & (ffi::SQLITE_OPEN_READWRITE | ffi::SQLITE_OPEN_CREATE) == 0
+        {
+            MAIN
+        } else if name == Some(ctx.wal_name.as_bytes())
+            && flags & types == ffi::SQLITE_OPEN_WAL
+            && ctx.wal.is_some()
+            && ctx.exclusive_armed.load(Ordering::SeqCst)
+            && ctx.main_open.load(Ordering::SeqCst)
+        {
+            WAL
+        } else {
+            return ctx.record("open-denied", 0, flags.into(), 0, ffi::SQLITE_CANTOPEN);
+        };
+        if flags & (ffi::SQLITE_OPEN_URI | ffi::SQLITE_OPEN_DELETEONCLOSE | ffi::SQLITE_OPEN_MEMORY)
+            != 0
+        {
+            return ctx.record("open-denied", kind, flags.into(), 0, ffi::SQLITE_CANTOPEN);
+        }
+        if ctx.take_fault(Fault::OpenNoMem) {
+            return ctx.record("open-oom", kind, flags.into(), 0, ffi::SQLITE_NOMEM);
+        }
+        let opened = if kind == MAIN {
+            &ctx.main_open
+        } else {
+            &ctx.wal_open
+        };
+        if opened.swap(true, Ordering::SeqCst) {
+            return ctx.record(
+                "open-second-denied",
+                kind,
+                flags.into(),
+                0,
+                ffi::SQLITE_CANTOPEN,
+            );
+        }
+        if kind == MAIN {
+            ctx.exclusive_armed.store(false, Ordering::SeqCst);
+        }
+        // 不分配、不 dup、不重新解析路径；file 仅借 Registry 固定持有的 FD。
+        unsafe {
+            ptr::write(
+                out.cast::<PinnedFile>(),
+                PinnedFile {
+                    base: ffi::sqlite3_file { pMethods: &METHODS },
+                    ctx: (ctx as *const Context).cast(),
+                    kind,
+                    lock: ffi::SQLITE_LOCK_NONE,
+                },
+            );
+        }
+        ctx.active.fetch_add(1, Ordering::SeqCst);
+        if !out_flags.is_null() {
+            unsafe {
+                *out_flags = ffi::SQLITE_OPEN_READONLY;
+            }
+        }
+        // 已安装有效对象后若轨迹满，SQLite 仍可用 xClose 正常释放。
+        ctx.record(
+            "open",
+            kind,
+            flags.into(),
+            ffi::SQLITE_OPEN_READONLY.into(),
+            ffi::SQLITE_OK,
+        )
+    })
+}
+
+unsafe extern "C" fn close(file: *mut ffi::sqlite3_file) -> c_int {
+    let f = unsafe { &mut *file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || {
+        if f.base.pMethods.is_null() {
+            return ffi::SQLITE_IOERR_CLOSE;
+        }
+        f.base.pMethods = ptr::null();
+        if f.kind == MAIN {
+            ctx.main_open.store(false, Ordering::SeqCst);
+        } else {
+            ctx.wal_open.store(false, Ordering::SeqCst);
+        }
+        ctx.active.fetch_sub(1, Ordering::SeqCst);
+        let rc = if ctx.take_fault(Fault::CloseIo) {
+            ctx.close_errors.fetch_add(1, Ordering::SeqCst);
+            ffi::SQLITE_IOERR_CLOSE
+        } else {
+            ffi::SQLITE_OK
+        };
+        ctx.record("close", f.kind, 0, 0, rc)
+    })
+}
+
+unsafe extern "C" fn read(
+    file: *mut ffi::sqlite3_file,
+    out: *mut c_void,
+    amount: c_int,
+    offset: i64,
+) -> c_int {
+    let f = unsafe { &*file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    let rc = guarded(ctx, || {
+        if amount < 0
+            || offset < 0
+            || offset.checked_add(i64::from(amount)).is_none()
+            || (amount > 0 && out.is_null())
+        {
+            return ffi::SQLITE_IOERR_READ;
+        }
+        if amount == 0 {
+            return ffi::SQLITE_OK;
+        }
+        // SAFETY: SQLite 承诺 out 可写 amount 字节；先清零满足 short-read 合同。
+        let buf = unsafe { std::slice::from_raw_parts_mut(out.cast::<u8>(), amount as usize) };
+        buf.fill(0);
+        if ctx.take_fault(Fault::ReadPanic) {
+            panic!("1504 controlled callback panic");
+        }
+        if ctx.take_fault(Fault::ReadIo) {
+            return ffi::SQLITE_IOERR_READ;
+        }
+        if ctx.take_fault(Fault::ReadShort) {
+            return ffi::SQLITE_IOERR_SHORT_READ;
+        }
+        let Some(source) = ctx.source(f.kind) else {
+            return ffi::SQLITE_IOERR_READ;
+        };
+        if !source.unchanged() {
+            return ffi::SQLITE_IOERR_FSTAT;
+        }
+        let mut done = 0;
+        while done < buf.len() {
+            if !ctx.before_io() {
+                return ffi::SQLITE_IOERR_READ;
+            }
+            let part = if ctx.take_fault(Fault::ReadInterrupted) {
+                Err(std::io::Error::from(std::io::ErrorKind::Interrupted))
+            } else {
+                source
+                    .file
+                    .read_at(&mut buf[done..], offset as u64 + done as u64)
+            };
+            match part {
+                Ok(0) => {
+                    if !ctx.after_read(0) {
+                        return ffi::SQLITE_IOERR_READ;
+                    }
+                    break;
+                }
+                Ok(n) => {
+                    done += n;
+                    ctx.read_bytes.fetch_add(n as u64, Ordering::SeqCst);
+                    if !ctx.after_read(n as u64) {
+                        return ffi::SQLITE_IOERR_READ;
+                    }
+                }
+                Err(_) => {
+                    let _ = ctx.after_read(0);
+                    return ffi::SQLITE_IOERR_READ;
+                }
+            }
+        }
+        if !source.unchanged() {
+            return ffi::SQLITE_IOERR_FSTAT;
+        }
+        if done < buf.len() {
+            ffi::SQLITE_IOERR_SHORT_READ
+        } else {
+            ffi::SQLITE_OK
+        }
+    });
+    guarded(ctx, || {
+        ctx.record("read", f.kind, offset, amount.into(), rc)
+    })
+}
+
+unsafe fn file_event(file: *mut ffi::sqlite3_file, op: &'static str, a: i64, rc: i32) -> i32 {
+    let f = unsafe { &*file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || ctx.record(op, f.kind, a, 0, rc))
+}
+
+unsafe extern "C" fn write(
+    file: *mut ffi::sqlite3_file,
+    _: *const c_void,
+    n: c_int,
+    _: i64,
+) -> c_int {
+    unsafe { file_event(file, "write-denied", n.into(), ffi::SQLITE_READONLY) }
+}
+unsafe extern "C" fn truncate(file: *mut ffi::sqlite3_file, n: i64) -> c_int {
+    unsafe { file_event(file, "truncate-denied", n, ffi::SQLITE_READONLY) }
+}
+unsafe extern "C" fn sync(file: *mut ffi::sqlite3_file, _: c_int) -> c_int {
+    unsafe { file_event(file, "sync-readonly-noop", 0, ffi::SQLITE_OK) }
+}
+unsafe extern "C" fn size(file: *mut ffi::sqlite3_file, out: *mut i64) -> c_int {
+    let f = unsafe { &*file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || {
+        if out.is_null() {
+            return ffi::SQLITE_IOERR_FSTAT;
+        }
+        let Some(source) = ctx.source(f.kind) else {
+            return ffi::SQLITE_IOERR_FSTAT;
+        };
+        if !source.unchanged() {
+            return ffi::SQLITE_IOERR_FSTAT;
+        }
+        unsafe {
+            *out = source.identity.len as i64;
+        }
+        ctx.record(
+            "size",
+            f.kind,
+            source.identity.len as i64,
+            0,
+            ffi::SQLITE_OK,
+        )
+    })
+}
+unsafe extern "C" fn lock(file: *mut ffi::sqlite3_file, level: c_int) -> c_int {
+    let f = unsafe { &mut *file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || {
+        if !(ffi::SQLITE_LOCK_SHARED..=ffi::SQLITE_LOCK_EXCLUSIVE).contains(&level) {
+            return ffi::SQLITE_IOERR_LOCK;
+        }
+        f.lock = f.lock.max(level);
+        ctx.record("lock-virtual", f.kind, level.into(), 0, ffi::SQLITE_OK)
+    })
+}
+unsafe extern "C" fn unlock(file: *mut ffi::sqlite3_file, level: c_int) -> c_int {
+    let f = unsafe { &mut *file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || {
+        if ![ffi::SQLITE_LOCK_NONE, ffi::SQLITE_LOCK_SHARED].contains(&level) || level > f.lock {
+            return ffi::SQLITE_IOERR_UNLOCK;
+        }
+        f.lock = level;
+        ctx.record("unlock-virtual", f.kind, level.into(), 0, ffi::SQLITE_OK)
+    })
+}
+unsafe extern "C" fn reserved(file: *mut ffi::sqlite3_file, out: *mut c_int) -> c_int {
+    let f = unsafe { &*file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || {
+        if out.is_null() {
+            return ffi::SQLITE_IOERR_CHECKRESERVEDLOCK;
+        }
+        unsafe {
+            *out = i32::from(f.lock >= ffi::SQLITE_LOCK_RESERVED);
+        }
+        ctx.record("reserved-virtual", f.kind, f.lock.into(), 0, ffi::SQLITE_OK)
+    })
+}
+unsafe extern "C" fn control(file: *mut ffi::sqlite3_file, op: c_int, arg: *mut c_void) -> c_int {
+    let f = unsafe { &*file.cast::<PinnedFile>() };
+    let ctx = unsafe { &*f.ctx.cast::<Context>() };
+    guarded(ctx, || {
+        let rc = if op == ffi::SQLITE_FCNTL_LOCKSTATE && !arg.is_null() {
+            unsafe {
+                *arg.cast::<c_int>() = f.lock;
+            }
+            ffi::SQLITE_OK
+        } else {
+            ffi::SQLITE_NOTFOUND
+        };
+        ctx.record("file-control", f.kind, op.into(), 0, rc)
+    })
+}
+unsafe extern "C" fn sector(_: *mut ffi::sqlite3_file) -> c_int {
+    512
+}
+unsafe extern "C" fn characteristics(_: *mut ffi::sqlite3_file) -> c_int {
+    0
+}
+
+static METHODS: ffi::sqlite3_io_methods = ffi::sqlite3_io_methods {
+    iVersion: 1,
+    xClose: Some(close),
+    xRead: Some(read),
+    xWrite: Some(write),
+    xTruncate: Some(truncate),
+    xSync: Some(sync),
+    xFileSize: Some(size),
+    xLock: Some(lock),
+    xUnlock: Some(unlock),
+    xCheckReservedLock: Some(reserved),
+    xFileControl: Some(control),
+    xSectorSize: Some(sector),
+    xDeviceCharacteristics: Some(characteristics),
+    xShmMap: None,
+    xShmLock: None,
+    xShmBarrier: None,
+    xShmUnmap: None,
+    xFetch: None,
+    xUnfetch: None,
+};
+
+unsafe extern "C" fn access(
+    vfs: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    flags: c_int,
+    out: *mut c_int,
+) -> c_int {
+    let ctx = unsafe { context(vfs) };
+    guarded(ctx, || {
+        if out.is_null() {
+            return ffi::SQLITE_IOERR_ACCESS;
+        }
+        unsafe {
+            *out = 0;
+        }
+        let name = unsafe { bytes(name) };
+        let exists = if name == Some(ctx.main_name.as_bytes()) {
+            true
+        } else if name == Some(ctx.wal_name.as_bytes()) {
+            ctx.wal.is_some()
+        } else if name == Some(ctx.journal_name.as_bytes()) || name == Some(ctx.shm_name.as_bytes())
+        {
+            false
+        } else {
+            return ctx.record(
+                "access-domain-denied",
+                0,
+                flags.into(),
+                0,
+                ffi::SQLITE_IOERR_ACCESS,
+            );
+        };
+        if ![
+            ffi::SQLITE_ACCESS_EXISTS,
+            ffi::SQLITE_ACCESS_READ,
+            ffi::SQLITE_ACCESS_READWRITE,
+        ]
+        .contains(&flags)
+        {
+            return ffi::SQLITE_IOERR_ACCESS;
+        }
+        unsafe {
+            *out = i32::from(exists && flags != ffi::SQLITE_ACCESS_READWRITE);
+        }
+        ctx.record("access", 0, flags.into(), i64::from(exists), ffi::SQLITE_OK)
+    })
+}
+unsafe extern "C" fn delete(vfs: *mut ffi::sqlite3_vfs, _: *const c_char, _: c_int) -> c_int {
+    let ctx = unsafe { context(vfs) };
+    guarded(ctx, || {
+        ctx.record("delete-denied", 0, 0, 0, ffi::SQLITE_READONLY)
+    })
+}
+unsafe extern "C" fn fullpath(
+    vfs: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    n: c_int,
+    out: *mut c_char,
+) -> c_int {
+    let ctx = unsafe { context(vfs) };
+    guarded(ctx, || {
+        if unsafe { bytes(name) } != Some(ctx.main_name.as_bytes())
+            || out.is_null()
+            || n < 1
+            || n as usize <= ctx.main_name.as_bytes().len()
+        {
+            return ctx.record("fullpath-denied", 0, n.into(), 0, ffi::SQLITE_CANTOPEN);
+        }
+        unsafe {
+            ptr::copy_nonoverlapping(
+                ctx.main_name.as_ptr(),
+                out,
+                ctx.main_name.as_bytes_with_nul().len(),
+            );
+        }
+        ctx.record("fullpath-virtual", 0, n.into(), 0, ffi::SQLITE_OK)
+    })
+}
+unsafe extern "C" fn dl_open(vfs: *mut ffi::sqlite3_vfs, _: *const c_char) -> *mut c_void {
+    let ctx = unsafe { context(vfs) };
+    guarded(ctx, || {
+        ctx.record("extension-denied", 0, 0, 0, ffi::SQLITE_AUTH)
+    });
+    ptr::null_mut()
+}
+unsafe extern "C" fn dl_error(_: *mut ffi::sqlite3_vfs, n: c_int, out: *mut c_char) {
+    if n > 0 && !out.is_null() {
+        unsafe {
+            *out = 0;
+        }
+    }
+}
+unsafe extern "C" fn dl_close(_: *mut ffi::sqlite3_vfs, _: *mut c_void) {}
+unsafe extern "C" fn randomness(_: *mut ffi::sqlite3_vfs, n: c_int, out: *mut c_char) -> c_int {
+    if n <= 0 || out.is_null() {
+        return 0;
+    }
+    // getentropy 的系统接口不接 pathname；每次最多 256 字节。
+    let mut done = 0;
+    while done < n {
+        let count = (n - done).min(256) as usize;
+        if unsafe { libc::getentropy(out.add(done as usize).cast(), count) } != 0 {
+            return done;
+        }
+        done += count as i32;
+    }
+    n
+}
+unsafe extern "C" fn sleep(_: *mut ffi::sqlite3_vfs, _: c_int) -> c_int {
+    0
+}
+unsafe extern "C" fn current_time(_: *mut ffi::sqlite3_vfs, out: *mut f64) -> c_int {
+    if out.is_null() {
+        return ffi::SQLITE_ERROR;
+    }
+    std::panic::catch_unwind(|| match SystemTime::now().duration_since(UNIX_EPOCH) {
+        Ok(d) => {
+            unsafe {
+                *out = 2_440_587.5 + d.as_secs_f64() / 86400.0;
+            }
+            ffi::SQLITE_OK
+        }
+        Err(_) => ffi::SQLITE_ERROR,
+    })
+    .unwrap_or(ffi::SQLITE_ERROR)
+}
+
+unsafe extern "C" fn authorizer(
+    data: *mut c_void,
+    action: c_int,
+    a: *const c_char,
+    b: *const c_char,
+    _: *const c_char,
+    _: *const c_char,
+) -> c_int {
+    let ctx = unsafe { &*data.cast::<Context>() };
+    // 不支持的动作一律 DENY；panic 返回 IOERR 并不是合法 authorizer 返回值，转 DENY。
+    let rc = guarded(ctx, || {
+        let allowed = match action {
+            ffi::SQLITE_SELECT | ffi::SQLITE_READ => true,
+            ffi::SQLITE_FUNCTION => {
+                matches!(unsafe { bytes(b) }, Some(b"count" | b"length" | b"hex"))
+            }
+            ffi::SQLITE_PRAGMA => match (unsafe { bytes(a) }, unsafe { bytes(b) }) {
+                (Some(b"locking_mode"), Some(value)) => {
+                    !ctx.exclusive_armed.load(Ordering::SeqCst)
+                        && value.eq_ignore_ascii_case(b"exclusive")
+                }
+                (Some(b"locking_mode"), None) => true,
+                (Some(b"query_only"), Some(value)) => value == b"ON" || value == b"1",
+                (Some(b"temp_store"), Some(value)) => value.eq_ignore_ascii_case(b"memory"),
+                (Some(b"quick_check"), None) => true,
+                _ => false,
+            },
+            _ => false,
+        };
+        if allowed {
+            ffi::SQLITE_OK
+        } else {
+            ctx.sql_denials.fetch_add(1, Ordering::SeqCst);
+            ctx.record("sql-denied", 0, action.into(), 0, ffi::SQLITE_DENY)
+        }
+    });
+    if rc == ffi::SQLITE_OK {
+        rc
+    } else {
+        ffi::SQLITE_DENY
+    }
+}
+
+pub(super) struct Registration<'a> {
+    vfs: Option<Box<ffi::sqlite3_vfs>>,
+    ctx: Option<Box<Context<'a>>>,
+    name: Option<CString>,
+    _not_send_or_sync: PhantomData<Rc<()>>,
+}
+
+pub(super) struct Session<'r, 'a> {
+    connection: Option<Connection>,
+    owner: &'r Registration<'a>,
+}
+
+impl Session<'_, '_> {
+    pub fn connection(&self) -> &Connection {
+        self.connection.as_ref().expect("live session")
+    }
+    pub fn close(mut self) -> Result<()> {
+        let c = self.connection.take().ok_or("already closed")?;
+        match c.close() {
+            Ok(()) => {
+                if self.owner.ctx().close_errors.load(Ordering::SeqCst) > 0 {
+                    Err("VFS close callback failed".into())
+                } else {
+                    Ok(())
+                }
+            }
+            Err((c, e)) => {
+                drop(c);
+                Err(e.into())
+            }
+        }
+    }
+}
+
+impl<'a> Registration<'a> {
+    pub fn new(
+        main_file: File,
+        wal_file: Option<File>,
+        account: &'a mut dyn IoAccounting,
+    ) -> Result<Self> {
+        account.before_io()?;
+        // D1 机制与固定 bundled SQLite source id 绑定，不换成宿主 SQLite 重试。
+        let source_id = unsafe { CStr::from_ptr(ffi::sqlite3_sourceid()) };
+        if source_id.to_bytes() != EXPECTED_SOURCE_ID.as_bytes() {
+            return Err("PrivateSqliteSourceIdMismatch".into());
+        }
+        let main = Source::pin(main_file)?;
+        let wal = wal_file.map(Source::pin).transpose()?;
+        if wal.as_ref().is_some_and(|w| {
+            w.identity.dev == main.identity.dev && w.identity.ino == main.identity.ino
+        }) {
+            return Err("main and WAL alias".into());
+        }
+        let id = NEXT_ID.fetch_add(1, Ordering::SeqCst);
+        let name = CString::new(format!("s1527-d1-{}-{id}", std::process::id()))?;
+        let main_name = format!("/s1527/d1/{}/{id}/main", std::process::id());
+        let mut ctx = Box::new(Context {
+            main,
+            wal,
+            main_name: CString::new(main_name.clone())?,
+            wal_name: CString::new(format!("{main_name}-wal"))?,
+            journal_name: CString::new(format!("{main_name}-journal"))?,
+            shm_name: CString::new(format!("{main_name}-shm"))?,
+            account: RefCell::new(account),
+            trace_overflow: AtomicBool::new(false),
+            main_open: AtomicBool::new(false),
+            wal_open: AtomicBool::new(false),
+            active: AtomicUsize::new(0),
+            exclusive_armed: AtomicBool::new(false),
+            fault: AtomicI32::new(0),
+            caught_panics: AtomicUsize::new(0),
+            close_errors: AtomicUsize::new(0),
+            sql_denials: AtomicUsize::new(0),
+            read_bytes: AtomicU64::new(0),
+            retries: AtomicUsize::new(0),
+        });
+        let mut vfs = Box::new(ffi::sqlite3_vfs {
+            iVersion: 1,
+            szOsFile: std::mem::size_of::<PinnedFile>() as i32,
+            mxPathname: 256,
+            pNext: ptr::null_mut(),
+            zName: name.as_ptr(),
+            pAppData: (&mut *ctx as *mut Context).cast(),
+            xOpen: Some(open),
+            xDelete: Some(delete),
+            xAccess: Some(access),
+            xFullPathname: Some(fullpath),
+            xDlOpen: Some(dl_open),
+            xDlError: Some(dl_error),
+            xDlSym: None,
+            xDlClose: Some(dl_close),
+            xRandomness: Some(randomness),
+            xSleep: Some(sleep),
+            xCurrentTime: Some(current_time),
+            xGetLastError: None,
+            xCurrentTimeInt64: None,
+            xSetSystemCall: None,
+            xGetSystemCall: None,
+            xNextSystemCall: None,
+        });
+        // SAFETY: 名字、vfs、ctx 在 Box 中稳定；makeDflt=0，不改变默认 VFS。
+        let rc = unsafe { ffi::sqlite3_vfs_register(&mut *vfs, 0) };
+        if rc != ffi::SQLITE_OK {
+            return Err(format!("register rc={rc}").into());
+        }
+        Ok(Self {
+            vfs: Some(vfs),
+            ctx: Some(ctx),
+            name: Some(name),
+            _not_send_or_sync: PhantomData,
+        })
+    }
+
+    fn ctx(&self) -> &Context<'a> {
+        self.ctx.as_deref().expect("live registration")
+    }
+    pub fn inject(&self, fault: Fault) {
+        self.ctx().fault.store(fault as i32, Ordering::SeqCst);
+    }
+    pub fn sql_denials(&self) -> usize {
+        self.ctx().sql_denials.load(Ordering::SeqCst)
+    }
+    pub fn name(&self) -> &CStr {
+        self.name.as_deref().expect("live registration")
+    }
+    pub fn main_name(&self) -> &str {
+        self.ctx().main_name.to_str().expect("generated ASCII")
+    }
+
+    pub fn connect(&self, exclusive_before_read: bool) -> Result<Session<'_, 'a>> {
+        let c = Connection::open_with_flags_and_vfs(
+            self.main_name(),
+            OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+            self.name(),
+        )?;
+        c.busy_timeout(std::time::Duration::ZERO)?;
+        c.set_limit(rusqlite::limits::Limit::SQLITE_LIMIT_WORKER_THREADS, 0)?;
+        if c.limit(rusqlite::limits::Limit::SQLITE_LIMIT_WORKER_THREADS)? != 0 {
+            return Err("PrivateSqliteWorkersEnabled".into());
+        }
+        for (cfg, value) in [
+            (DbConfig::SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE, true),
+            (DbConfig::SQLITE_DBCONFIG_DEFENSIVE, true),
+        ] {
+            if c.set_db_config(cfg, value)? != value {
+                return Err("db config did not stick".into());
+            }
+        }
+        // rusqlite 没有公开此 DbConfig 变体；直接调用 bundled C API 并核回值。
+        let mut extensions_enabled: c_int = -1;
+        let rc = unsafe {
+            ffi::sqlite3_db_config(
+                c.handle(),
+                ffi::SQLITE_DBCONFIG_ENABLE_LOAD_EXTENSION,
+                0 as c_int,
+                &mut extensions_enabled as *mut c_int,
+            )
+        };
+        if rc != ffi::SQLITE_OK || extensions_enabled != 0 {
+            return Err("extension loading remains enabled".into());
+        }
+        // SAFETY: 回调 ctx 和 Connection 同受 Registration 的借用寿命覆盖。
+        let rc = unsafe {
+            ffi::sqlite3_set_authorizer(
+                c.handle(),
+                Some(authorizer),
+                (self.ctx() as *const Context).cast_mut().cast(),
+            )
+        };
+        if rc != ffi::SQLITE_OK {
+            return Err(format!("authorizer rc={rc}").into());
+        }
+        if exclusive_before_read {
+            let mode: String = c.query_row("PRAGMA locking_mode=EXCLUSIVE", [], |r| r.get(0))?;
+            let check: String = c.query_row("PRAGMA locking_mode", [], |r| r.get(0))?;
+            if !mode.eq_ignore_ascii_case("exclusive") || mode != check {
+                return Err("exclusive mode missing".into());
+            }
+            self.ctx().exclusive_armed.store(true, Ordering::SeqCst);
+            if self
+                .ctx()
+                .record("exclusive-armed", 0, 0, 0, ffi::SQLITE_OK)
+                != ffi::SQLITE_OK
+            {
+                return Err("trace capacity exhausted".into());
+            }
+        }
+        c.execute_batch("PRAGMA query_only=ON; PRAGMA temp_store=MEMORY;")?;
+        Ok(Session {
+            connection: Some(c),
+            owner: self,
+        })
+    }
+
+    pub fn finish(mut self) -> Result<()> {
+        if self.ctx().active.load(Ordering::SeqCst) != 0
+            || self.ctx().caught_panics.load(Ordering::SeqCst) != 0
+            || self.ctx().close_errors.load(Ordering::SeqCst) != 0
+            || !self.ctx().main.unchanged()
+            || !self.ctx().wal.as_ref().is_none_or(Source::unchanged)
+        {
+            return Err("PrivateVfsCleanupOrSourceChanged".into());
+        }
+        let rc = unsafe { ffi::sqlite3_vfs_unregister(self.vfs.as_deref_mut().ok_or("no vfs")?) };
+        if rc != ffi::SQLITE_OK {
+            return Err("PrivateVfsUnregister".into());
+        }
+        self.vfs.take();
+        self.ctx.take();
+        Ok(())
+    }
+}
+impl Drop for Registration<'_> {
+    fn drop(&mut self) {
+        if let Some(mut vfs) = self.vfs.take() {
+            // 若内部生命周期被破坏，不能留下指向已离栈记账门面的活 C 回调；立即终止。
+            let live = self
+                .ctx
+                .as_deref()
+                .is_some_and(|c| c.active.load(Ordering::SeqCst) != 0);
+            let rc = unsafe { ffi::sqlite3_vfs_unregister(&mut *vfs) };
+            if live || rc != ffi::SQLITE_OK {
+                std::process::abort();
+            }
+        }
+    }
+}
diff --git a/rust/src/bin/s_session_v3/admission_private/mod.rs b/rust/src/bin/s_session_v3/admission_private/mod.rs
new file mode 100644
index 0000000000..aba317d7fe
--- /dev/null
+++ b/rust/src/bin/s_session_v3/admission_private/mod.rs
@@ -0,0 +1,70 @@
+//! #1527：私有 SQLite 仅通过固定只读 FD VFS。无源 RW、无默认 VFS 兜底、无文件 clone。
+mod fd_wal;
+use super::admission_anchor::AdmissionAccounting;
+use super::admission_provider::{MeasuredDomain, Medium};
+
+/// C 回调只看受限门面；不得取得 Job、StartedAdmission 或结束资格。
+pub(super) trait IoAccounting {
+    fn before_io(&mut self) -> Result<(), Box<dyn std::error::Error>>;
+    fn after_read(&mut self, actual: u64) -> Result<(), Box<dyn std::error::Error>>;
+}
+impl IoAccounting for AdmissionAccounting<'_> {
+    fn before_io(&mut self) -> Result<(), Box<dyn std::error::Error>> {
+        self.pre_io_check().map_err(Into::into)
+    }
+    fn after_read(&mut self, actual: u64) -> Result<(), Box<dyn std::error::Error>> {
+        self.charge_wire_bytes(actual).map_err(Into::into)
+    }
+}
+
+pub(super) fn validate(
+    source: &MeasuredDomain,
+    account: &mut AdmissionAccounting<'_>,
+) -> Result<(), String> {
+    account.pre_io_check().map_err(|e| e.to_string())?;
+    match source.medium {
+        Medium::RollbackJournal => return Err("D2ProductionCapacityMissing：JobLimits8/SResources7没有已裁的overlay payload、metadata与SQLite heap额度映射；禁止采用D2-SMALL六参数默认".into()),
+        Medium::MainOnly | Medium::Wal => {}
+    }
+    // D1 的所有 xWrite/xDelete/xTruncate 都拒绝，未提供 xShmMap，不创建临时磁盘文件。
+    // 因而此机制的新增磁盘 allocation_upper 精确为 0，不是未知上界填 0。
+    let grant = account.reserve_staged(0).map_err(|e| e.to_string())?;
+    let result = (|| {
+        let main = source.main_fd()?;
+        let wal = source.wal_fd()?;
+        let registration = fd_wal::Registration::new(main, wal, account)
+            .map_err(|_| "PrivateVfsRegistrationFailed")?;
+        let result = (|| {
+            let session = registration
+                .connect(true)
+                .map_err(|_| "PrivateSqliteOpenFailed")?;
+            let check = (|| {
+                let mut stmt = session
+                    .connection()
+                    .prepare("PRAGMA quick_check")
+                    .map_err(|_| "PrivateSqliteCheckFailed")?;
+                let mut rows = stmt.query([]).map_err(|_| "PrivateSqliteCheckFailed")?;
+                let mut seen = false;
+                while let Some(row) = rows.next().map_err(|_| "PrivateSqliteCheckFailed")? {
+                    let text: String = row.get(0).map_err(|_| "PrivateSqliteCheckFailed")?;
+                    if text != "ok" || seen {
+                        return Err("PrivateSqliteIntegrityRejected");
+                    }
+                    seen = true;
+                }
+                if !seen {
+                    return Err("PrivateSqliteIntegrityEmpty");
+                }
+                Ok(())
+            })();
+            let closed = session.close().map_err(|_| "PrivateSqliteCloseFailed");
+            check.and(closed)
+        })();
+        let cleanup = registration.finish().map_err(|_| "PrivateVfsCleanupFailed");
+        result.and(cleanup).map_err(str::to_string)
+    })();
+    // SQLite/Registration 都先关闭，再结原预留；失败原 Job 快照仍由外层保留。
+    let reconciled = account.reconcile(&grant, 0).map_err(|e| e.to_string());
+    let budget = account.check_deadline().map_err(|e| e.to_string());
+    budget.and(result).and(reconciled)
+}
diff --git a/rust/src/bin/s_session_v3/admission_provider.rs b/rust/src/bin/s_session_v3/admission_provider.rs
new file mode 100644
index 0000000000..89b4dc9762
--- /dev/null
+++ b/rust/src/bin/s_session_v3/admission_provider.rs
@@ -0,0 +1,352 @@
+//! #1527 I-1：真实文件域测量。只测分配/固定来源，不解释 SQLite 页、WAL 或 journal。
+//! st_blocks*512 是 OS 报告的文件/目录已分配量；不是共享 extent 独占性或 inode 隐藏开销证明。
+use super::admission_anchor::{ConsumedAdmission, Stage};
+use newchan_rust::s_content::job::Existing;
+use std::collections::BTreeSet;
+use std::fs::{File, Metadata, OpenOptions};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Stamp {
+    dev: u64,
+    ino: u64,
+    mode: u32,
+    uid: u32,
+    nlink: u64,
+    len: u64,
+    blocks: u64,
+    mtime: (i64, i64),
+    ctime: (i64, i64),
+}
+impl Stamp {
+    fn of(m: &Metadata) -> Self {
+        Self {
+            dev: m.dev(),
+            ino: m.ino(),
+            mode: m.mode(),
+            uid: m.uid(),
+            nlink: m.nlink(),
+            len: m.len(),
+            blocks: m.blocks(),
+            mtime: (m.mtime(), m.mtime_nsec()),
+            ctime: (m.ctime(), m.ctime_nsec()),
+        }
+    }
+    fn same_object(self, other: Self) -> bool {
+        (self.dev, self.ino, self.mode, self.uid, self.nlink)
+            == (other.dev, other.ino, other.mode, other.uid, other.nlink)
+    }
+}
+struct Pinned {
+    path: PathBuf,
+    file: File,
+    stamp: Stamp,
+    directory: bool,
+}
+impl Pinned {
+    fn open(path: &Path) -> Result<Self, String> {
+        let m = std::fs::symlink_metadata(path).map_err(|_| "SourceMetadataUnavailable")?;
+        if !(m.is_file() || m.is_dir()) || (m.is_file() && m.nlink() != 1) {
+            return Err("SourceTypeOrHardlinkUnsupported".into());
+        }
+        let f = OpenOptions::new()
+            .read(true)
+            .custom_flags(
+                libc::O_NOFOLLOW
+                    | libc::O_NONBLOCK
+                    | libc::O_CLOEXEC
+                    | if m.is_dir() { libc::O_DIRECTORY } else { 0 },
+            )
+            .open(path)
+            .map_err(|_| "SourcePinFailed")?;
+        let fm = f.metadata().map_err(|_| "SourceMetadataUnavailable")?;
+        if Stamp::of(&m) != Stamp::of(&fm) {
+            return Err("SourceChangedDuringPin".into());
+        }
+        Ok(Self {
+            path: path.into(),
+            file: f,
+            stamp: Stamp::of(&fm),
+            directory: fm.is_dir(),
+        })
+    }
+    fn verify(&self, strict: bool) -> Result<(), String> {
+        let a = self.file.metadata().map_err(|_| "SourceFdLost")?;
+        let b = std::fs::symlink_metadata(&self.path).map_err(|_| "SourcePathLost")?;
+        let matches = |m: &Metadata| {
+            if strict {
+                Stamp::of(m) == self.stamp
+            } else {
+                self.stamp.same_object(Stamp::of(m))
+            }
+        };
+        if !matches(&a) || !matches(&b) {
+            return Err("SourceIdentityChanged".into());
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Medium {
+    MainOnly,
+    Wal,
+    RollbackJournal,
+}
+
+pub(super) struct MeasuredDomain {
+    db: PathBuf,
+    state: PathBuf,
+    files: Vec<Pinned>,
+    members: BTreeSet<PathBuf>,
+    main_index: usize,
+    wal_index: Option<usize>,
+    pub(super) medium: Medium,
+    pub(super) existing: Existing,
+}
+
+pub(super) fn sidecar(db: &Path, suffix: &str) -> PathBuf {
+    let mut path = db.as_os_str().to_os_string();
+    path.push(suffix);
+    PathBuf::from(path)
+}
+
+impl MeasuredDomain {
+    pub(super) fn measure(consumed: &ConsumedAdmission) -> Result<Self, String> {
+        consumed.check(Stage::E6).map_err(|e| e.to_string())?;
+        let db = consumed.lease().db_path().to_owned();
+        let state = consumed.lease().state_path().to_owned();
+        // 完整枚举本 DB basename 家族；不忽略未知 super-journal、旧私有目录等残件。
+        let members = Self::members(&db, &state, consumed)?;
+        let mut files = Vec::new();
+        let mut identities = BTreeSet::new();
+        let mut store = 0u64;
+        let mut staged = 0u64;
+        let mut main_index = None;
+        let mut wal_index = None;
+        let mut journal = false;
+        let mut shm = false;
+        for path in &members {
+            consumed.check(Stage::E6).map_err(|e| e.to_string())?;
+            let pinned = Pinned::open(path).map_err(|e| consumed.failure(&e))?;
+            consumed.check(Stage::E6).map_err(|e| e.to_string())?;
+            if !identities.insert((pinned.stamp.dev, pinned.stamp.ino)) {
+                return Err(consumed.failure("SourceAliasedMember"));
+            }
+            let physical = pinned
+                .stamp
+                .blocks
+                .checked_mul(512)
+                .ok_or_else(|| consumed.failure("AllocationOverflow"))?;
+            store = store
+                .checked_add(physical)
+                .ok_or_else(|| consumed.failure("AllocationOverflow"))?;
+            // 本实现不创建暂存。已存在的私有子树全部测入暂存和总账，随后具名拒绝，不删除未知来源。
+            if path.starts_with(sidecar(&db, ".admission-private")) {
+                staged = staged
+                    .checked_add(physical)
+                    .ok_or_else(|| consumed.failure("AllocationOverflow"))?;
+            }
+            if store > consumed.limits().max_store_bytes
+                || store > 64 * 1024 * 1024 * 1024
+                || staged > consumed.limits().max_staged_bytes
+            {
+                return Err(consumed.failure("ExistingAllocationExceeded"));
+            }
+            if path == &db {
+                main_index = Some(files.len());
+            }
+            if path == &sidecar(&db, "-wal") {
+                wal_index = Some(files.len());
+            }
+            journal |= path == &sidecar(&db, "-journal");
+            shm |= path == &sidecar(&db, "-shm");
+            files.push(pinned);
+        }
+        if members
+            .iter()
+            .any(|p| p.starts_with(sidecar(&db, ".admission-private")))
+        {
+            return Err(consumed.failure("PrivateResidueOwnershipUnproven"));
+        }
+        if shm || (journal && wal_index.is_some()) {
+            return Err(consumed.failure("UnsupportedWalShmJournalCombination"));
+        }
+        let medium = if journal {
+            Medium::RollbackJournal
+        } else if wal_index.is_some() {
+            Medium::Wal
+        } else {
+            Medium::MainOnly
+        };
+        let result = Self {
+            db,
+            state,
+            files,
+            members,
+            main_index: main_index.ok_or_else(|| consumed.failure("MainMissing"))?,
+            wal_index,
+            medium,
+            existing: Existing {
+                store_bytes: store,
+                staged_bytes: staged,
+            },
+        };
+        let verified = result.verify_before_open();
+        consumed.check(Stage::E6).map_err(|e| e.to_string())?;
+        verified.map_err(|e| consumed.failure(&e))?;
+        Ok(result)
+    }
+
+    fn members(
+        db: &Path,
+        state: &Path,
+        consumed: &ConsumedAdmission,
+    ) -> Result<BTreeSet<PathBuf>, String> {
+        let parent = db.parent().ok_or("SourceParentMissing")?;
+        let basename = db
+            .file_name()
+            .ok_or("SourceNameMissing")?
+            .as_encoded_bytes();
+        let mut set = BTreeSet::new();
+        set.insert(parent.to_owned());
+        for entry in
+            std::fs::read_dir(parent).map_err(|_| consumed.failure("SourceEnumerationFailed"))?
+        {
+            consumed.check(Stage::E6).map_err(|e| e.to_string())?;
+            let entry = entry.map_err(|_| consumed.failure("SourceEnumerationFailed"))?;
+            let name = entry.file_name();
+            let raw = name.as_encoded_bytes();
+            if raw == basename
+                || (raw.starts_with(basename)
+                    && matches!(raw.get(basename.len()), Some(b'.' | b'-')))
+            {
+                let path = entry.path();
+                if path != db
+                    && ![
+                        "-wal",
+                        "-shm",
+                        "-journal",
+                        ".writer.lock",
+                        ".maintenance.lock",
+                        ".control-owner.json",
+                        ".admission-private",
+                    ]
+                    .iter()
+                    .any(|suffix| path == sidecar(db, suffix))
+                {
+                    return Err(consumed.failure("UnknownDatabaseSidecar"));
+                }
+                Self::walk(&path, &mut set, consumed)?;
+            }
+        }
+        // parent 已列入分配账；state 恰为 parent 时仍须枚举其全部子项。
+        if state == parent {
+            set.remove(state);
+        }
+        Self::walk(state, &mut set, consumed)?;
+        Ok(set)
+    }
+    fn walk(
+        path: &Path,
+        out: &mut BTreeSet<PathBuf>,
+        consumed: &ConsumedAdmission,
+    ) -> Result<(), String> {
+        consumed.check(Stage::E6).map_err(|e| e.to_string())?;
+        if !out.insert(path.into()) {
+            return Ok(());
+        }
+        let m = std::fs::symlink_metadata(path)
+            .map_err(|_| consumed.failure("SourceMetadataUnavailable"))?;
+        if m.is_dir() {
+            for e in
+                std::fs::read_dir(path).map_err(|_| consumed.failure("SourceEnumerationFailed"))?
+            {
+                Self::walk(
+                    &e.map_err(|_| consumed.failure("SourceEnumerationFailed"))?
+                        .path(),
+                    out,
+                    consumed,
+                )?;
+            }
+        } else if !m.is_file() {
+            return Err(consumed.failure("SourceTypeUnsupported"));
+        }
+        Ok(())
+    }
+    pub(super) fn main_fd(&self) -> Result<File, String> {
+        self.files[self.main_index]
+            .file
+            .try_clone()
+            .map_err(|_| "SourceFdCloneFailed".into())
+    }
+    pub(super) fn wal_fd(&self) -> Result<Option<File>, String> {
+        self.wal_index
+            .map(|i| {
+                self.files[i]
+                    .file
+                    .try_clone()
+                    .map_err(|_| "SourceFdCloneFailed".into())
+            })
+            .transpose()
+    }
+    pub(super) fn verify_before_open(&self) -> Result<(), String> {
+        for p in &self.files {
+            p.verify(true)?;
+        }
+        // 新增 sidecar/状态成员也不得在私有核验之后悄悄进入源域。
+        let mut found = BTreeSet::new();
+        fn walk(path: &Path, set: &mut BTreeSet<PathBuf>) -> Result<(), String> {
+            if !set.insert(path.into()) {
+                return Ok(());
+            }
+            let m = std::fs::symlink_metadata(path).map_err(|_| "SourcePathLost")?;
+            if m.is_dir() {
+                for e in std::fs::read_dir(path).map_err(|_| "SourceEnumerationFailed")? {
+                    walk(&e.map_err(|_| "SourceEnumerationFailed")?.path(), set)?;
+                }
+            } else if !m.is_file() {
+                return Err("SourceTypeChanged".into());
+            }
+            Ok(())
+        }
+        let parent = self.db.parent().ok_or("SourceParentMissing")?;
+        found.insert(parent.into());
+        let basename = self
+            .db
+            .file_name()
+            .ok_or("SourceNameMissing")?
+            .as_encoded_bytes();
+        for e in std::fs::read_dir(parent).map_err(|_| "SourceEnumerationFailed")? {
+            let e = e.map_err(|_| "SourceEnumerationFailed")?;
+            let name = e.file_name();
+            let raw = name.as_encoded_bytes();
+            if raw == basename
+                || (raw.starts_with(basename)
+                    && matches!(raw.get(basename.len()), Some(b'.' | b'-')))
+            {
+                walk(&e.path(), &mut found)?;
+            }
+        }
+        if self.state == parent {
+            found.remove(&self.state);
+        }
+        walk(&self.state, &mut found)?;
+        if found != self.members {
+            return Err("SourceMembershipChanged".into());
+        }
+        Ok(())
+    }
+    /// 原件开始合法写入后不能再要求旧 mtime/长度；只核原主库和固定目录身份。
+    /// 此门不证明 sidecar 的跨开库连续性（I-3）。
+    pub(super) fn verify_runtime(&self) -> Result<(), String> {
+        self.files[self.main_index].verify(false)?;
+        for p in &self.files {
+            if p.directory {
+                p.verify(false)?;
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/s_session/tests/issue1527_recovery/anchor_tests.rs b/s_session/tests/issue1527_recovery/anchor_tests.rs
new file mode 100644
index 0000000000..91923537a6
--- /dev/null
+++ b/s_session/tests/issue1527_recovery/anchor_tests.rs
@@ -0,0 +1,402 @@
+//! #1527 Rust 源码测试；本轮 NOT_RUN，须在根协调模块接线后具名构建执行。
+use super::*;
+use serde_json::json;
+use std::io::Write;
+use std::os::unix::fs::{symlink, PermissionsExt};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static NEXT: AtomicU64 = AtomicU64::new(0);
+
+struct Fixture {
+    root: PathBuf,
+    db: PathBuf,
+    state: PathBuf,
+    owner: PathBuf,
+    limits: PathBuf,
+    binding: Value,
+    raw: Vec<u8>,
+}
+
+fn identity(path: &Path) -> Value {
+    let meta = std::fs::metadata(path).unwrap();
+    json!({"device": meta.dev(), "inode": meta.ino(), "uid": meta.uid(), "mode": meta.mode() & 0o7777})
+}
+
+fn write_file(path: &Path, bytes: &[u8], mode: u32) {
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(mode)
+        .open(path)
+        .unwrap();
+    file.write_all(bytes).unwrap();
+    file.set_permissions(std::fs::Permissions::from_mode(mode))
+        .unwrap();
+}
+
+fn limit_node() -> Value {
+    // TestOnly 小文件预算，不是部署默认或原生产帽的替代。
+    json!({
+        "max_total_wire_bytes":"1048576", "max_total_node_bytes":"1",
+        "max_total_nodes":"1", "max_total_records":"1", "max_total_requests":"1",
+        "max_elapsed_ms":"60000", "max_staged_bytes":"1", "max_store_bytes":"1"
+    })
+}
+
+impl Fixture {
+    fn new() -> Self {
+        Self::with_raw(serde_json::to_vec(&limit_node()).unwrap())
+    }
+
+    fn with_raw(raw: Vec<u8>) -> Self {
+        let root = std::env::temp_dir().join(format!(
+            "issue1527-anchor-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir(&root).unwrap();
+        let root = std::fs::canonicalize(root).unwrap();
+        let db = root.join("db");
+        let state = root.join("state");
+        write_file(&db, "TestOnly普通文件，不打开SQLite".as_bytes(), 0o600);
+        std::fs::create_dir(&state).unwrap();
+        // state 正常较宽权限；只有 s-admission 必须 0700。
+        std::fs::set_permissions(&state, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let published = state.join(PUBLISHED);
+        std::fs::create_dir(&published).unwrap();
+        std::fs::set_permissions(&published, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let limits = published.join(LIMITS_NAME);
+        let binding_path = published.join(BINDING_NAME);
+        write_file(&limits, &raw, 0o600);
+        write_file(&binding_path, b"", 0o600);
+        let binding = json!({
+            "db":db, "path":limits, "sha256":sha256_hex(&raw),
+            "file_identity":identity(&limits), "binding_identity":identity(&binding_path),
+            "directory_identity":identity(&published)
+        });
+        std::fs::write(&binding_path, serde_json::to_vec(&binding).unwrap()).unwrap();
+        let owner = root.join("db.control-owner.json");
+        let wire = json!({"db":db,"state_dir":state,"admission":binding});
+        write_file(&owner, &serde_json::to_vec(&wire).unwrap(), 0o600);
+        Self {
+            root,
+            db,
+            state,
+            owner,
+            limits,
+            binding,
+            raw,
+        }
+    }
+
