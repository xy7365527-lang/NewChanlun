+// 不运行 SQL、不保留 RefCell 借用，重入或 panic 一律 interrupt。
+unsafe extern "C" fn progress(data: *mut c_void) -> c_int {
+    let ctx = unsafe { &*data.cast::<Context>() };
+    let rc = guarded(ctx, || {
+        if ctx.before_io() {
+            ffi::SQLITE_OK
+        } else {
+            ffi::SQLITE_INTERRUPT
+        }
+    });
+    c_int::from(rc != ffi::SQLITE_OK)
+}
