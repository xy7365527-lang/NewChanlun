+        .unwrap()
+        .accounting()
+        .snapshot();
+    assert_eq!(after.wire_bytes - before.wire_bytes, actual * 2);
+    assert_eq!(after.nodes, before.nodes);
+    assert_eq!(after.records, before.records);
+}
