# ── LLM API 密钥 ──────────────────────────────────────────

# Anthropic (Claude audit / inquiry)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Codex challenger / inquiry)
OPENAI_API_KEY=your_openai_api_key_here

# Google (Gemini challenger / inquiry)
# GEMINI_API_KEY 是 GOOGLE_API_KEY 的别名，设置其中一个即可
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY=

# Gemini thinking budget（-1 = 无上限，正整数 = token 上限）
# GEMINI_THINKING_BUDGET=-1

# ── 数据源 API ────────────────────────────────────────────

# Alpha Vantage（美股基础数据）
ALPHAVANTAGE_API_KEY=your_api_key_here

# DataBento（美股+期货历史数据，主数据源）
DATABENTO_API_KEY=your_databento_api_key_here

# Brave Search（auto_feed 新闻摄入 + VPS deploy）
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_ANSWER_API_KEY=your_brave_answer_api_key_here

# ── IPFS / 链上存储 ──────────────────────────────────────

# IPFS HTTP API 地址（IPFSClient 默认 localhost:5001）
IPFS_API=http://localhost:5001

# ── 学术 API（VPS daemon 用）────────────────────────────

SEMANTIC_SCHOLAR_API=https://api.semanticscholar.org/graph/v1
ARXIV_API=https://export.arxiv.org/api
UNPAYWALL_EMAIL=your_email@example.com

# ── IBKR 连接配置 ─────────────────────────────────────────
# TWS paper: 7497, TWS live: 7496
# Gateway paper: 4002, Gateway live: 4001
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── 项目配置 ──────────────────────────────────────────────

# 本地缓存目录
CACHE_DIR=.cache

# 规格断言（调试/测试用）
# 设为 1/true/yes/on 时，A 系统断言失败将直接抛错（用于”锁语义”）
NEWCHAN_ASSERT=0

# 逢亮 daemon API 地址
# FENGLIANG_API=http://localhost:9765

# Escalate 自动发送（Chrome 窗口）
# ESCALATE_CONVERSATION_URL=
# CHROME_USER_DATA_DIR=
