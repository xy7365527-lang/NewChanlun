# 谱系发生史数据（block-topology 区块 JSON，非代码，去 git 跟踪以瘦身索引；物理文件保留）
.chanlun/block-topology/blocks/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Lean / Lake build artifacts (formal/ Lean 工程；源码 tracked，构建产物 ignore)
formal/.lake/
.lake/
*.olean

# Virtual environment
.venv/

# Environment
.env
.env.*
.env.bak-*

# IDE / tools
.cursor/
.claude/*
!.claude/rules/
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
!.claude/settings.local.json
!.claude/team-topology.json
.serena/
.cache/
.pytest_cache/

# Node
node_modules/

# OS
nul
Thumbs.db
.DS_Store

# Ceremony state (runtime only)
.ceremony-step

# Data / temp
_test_db.py
charting-library-context.txt
tmp/

# Deploy package (reference only)
deploy/

# Data files
data/
# 例外：trading_system/data/ 是源码目录（loader/fetch 脚本，非数据）——源码必须入库。
# 实际数据落 analysis/data_cache/ 与 .cache/（另行忽略）。
!trading_system/data/
.coverage

# K4 soros reports (cron 写入，不入库；保留目录占位)
external/k4-soros-reports/*
!external/k4-soros-reports/.gitkeep

# 运行时状态/日志（非源码，不入库）
scripts/.ph_push_state.json
.chanlun/.stop-guard-counter
.chanlun/.lead-corrections.log

# Rust 编译产物
rust/target/

# Analysis 数据缓存与可视化产物（3.9G+，可从脚本重建，不入库）
#   目录写法改 `/*`（#360）：目录级排除无法被后续 `!` 重新纳入（git 规则），而 venue 费率
#   datum 必须入仓——它是 KB 级人工核录的版本化快照，**不可由脚本重建**，且 sha256 契约
#   要求任何 clone 都能 `shasum -a 256 -c` 复核。行情缓存的排除范围不变。
analysis/data_cache/*
!analysis/data_cache/venue_fee_*.json
!analysis/data_cache/venue_fee_*.json.sha256
analysis/charts/

# newchan_rust wheel shadow 安装（.so 二进制 + __pycache__，可由 maturin 重建）
analysis/_p0p1/_nr_shadow/

# Analysis 运行日志（运行时产物，不入库）
analysis/logs/
*.log

# Playwright MCP 临时日志
.playwright-mcp/

# NautilusTrader 上游克隆（独立 git 仓库，不作为子模块入库）
/nautilus_trader/

# 548号 hook 运行时痕迹审计开关（可控 debug 开关，默认 off）
.chanlun/.hook-trace-enabled
.chanlun/.hook-trace.log

# precompact-save.sh 自动快照（运行时产物，ceremony 只读最新，累积不入库）
.chanlun/sessions/
