{
  "dependencies": [
    ".",
    "../approval-signing"
  ],
  "graphs": {
    "pilot1742": "pilot1742.studio:graph"
  },
  "http": {
    "app": "pilot1742.studio:app",
    "disable_runs": false,
    "disable_threads": false,
    "disable_store": true,
    "disable_ui": true,
    "disable_mcp": true,
    "disable_a2a": true,
    "disable_webhooks": true,
    "cors": {
      "allow_origins": [
        "https://smith.langchain.com"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "OPTIONS"
      ],
      "allow_headers": [
        "*"
      ],
      "allow_credentials": true
    }
  },
  "checkpointer": {
    "path": "pilot1742.studio_binding.make_checkpointer"
  }
}
