<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.newchanlun.sandcastle-harvest.plist —— sandcastle 收割定时任务（#1660）

  职责：每 15 分钟跑一轮 harvest.sh。对评审工蜂已完成、票仍 open 且无 open blocker 的
  sandcastle/issue-<n> 分支：推分支 → 基于 main 开 PR（Refs #n）→ 票面登记一条评论。
  不合入、不推 main、不关票、不删分支；构建测试交 CI，本机不跑 cargo。

  宿主 = sandcastle-host 专用克隆（工蜂分支只在这里），与 claimer / wayfinder-engine 同宿主。
  安装/卸载：bash .sandcastle/install-sandcastle-harvest.sh [install|uninstall|status]
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newchanlun.sandcastle-harvest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/silencehan/Projects/NewChanlun-sandcastle-host/.sandcastle/harvest.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/silencehan/Projects/NewChanlun-sandcastle-host</string>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/silencehan/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>SANDCASTLE_HOST_REPO</key>
        <string>/Users/silencehan/Projects/NewChanlun-sandcastle-host</string>
        <key>HARVEST_GH_REPO</key>
        <string>xy7365527-lang/NewChanlun</string>
        <key>NO_COLOR</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/silencehan/Projects/NewChanlun-sandcastle-host/.sandcastle/logs/harvest.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/silencehan/Projects/NewChanlun-sandcastle-host/.sandcastle/logs/harvest.stderr.log</string>
</dict>
</plist>
