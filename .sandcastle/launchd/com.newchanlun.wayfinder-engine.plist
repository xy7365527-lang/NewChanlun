<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.newchanlun.wayfinder-engine.plist —— wayfinder_engine 控制面常驻任务（#1084 追加）

  职责：把 DAG 走查器部署成真实受管常驻控制面（tracker 仍是唯一账本）。
  每轮：DAG 走查（draft_spec / split_impl_tickets / close_graph）+ 队列交棒
  （只给合资格实装票挂 sandcastle）+ 五桶状态页 .sandcastle/logs/wayfinder-status.md。

  安装/卸载：bash .sandcastle/install-wayfinder-engine.sh [install|uninstall|status]
  注意：REPO 路径 /Users/silencehan/Projects/NewChanlun 需与本机实际仓路径一致
  （与 watcher.sh / harvest.sh 同款硬编码）。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newchanlun.wayfinder-engine</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/silencehan/Projects/NewChanlun/.sandcastle/run-wayfinder-engine.sh</string>
        <string>--live</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/silencehan/Projects/NewChanlun</string>

    <!-- 常驻：退出即拉起；引擎内部 for(;;) 轮询，正常永不退出。 -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>GH_REPO</key>
        <string>xy7365527-lang/NewChanlun</string>
        <key>NO_COLOR</key>
        <string>1</string>
        <key>CLICOLOR</key>
        <string>0</string>
        <key>FORCE_COLOR</key>
        <string>0</string>
        <key>CLICOLOR_FORCE</key>
        <string>0</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/silencehan/Projects/NewChanlun/.sandcastle/logs/wayfinder-engine.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/silencehan/Projects/NewChanlun/.sandcastle/logs/wayfinder-engine.stderr.log</string>
</dict>
</plist>
