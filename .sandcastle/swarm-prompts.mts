/** #1742：Docker swarm 的 prompt 全部在宿主渲染成 inline。容器内没有 GitHub 凭据（方案 B 只接受 CLIProxy 密钥这一项残余暴露），
 * 所以 `!`gh …`` 块不能在容器里展开；票面与队列由宿主已认证的 gh 取得后注入。Sandcastle 对 inline prompt 不做 shell 展开。 */
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { parseStageReport } from "./managed-commit.mts";

export type HostGh = (args: string[]) => string;
export const hostGh = (env: NodeJS.ProcessEnv): HostGh => (args) =>
  execFileSync("gh", args, { encoding: "utf8", env, maxBuffer: 16 * 1024 * 1024 });

/** 与原 plan-prompt.md 的内联命令相同：label sandcastle、open、limit 50、无 assignee，输出 {number,title,labels}。 */
export const QUEUE_ARGS = ["issue", "list", "--label", "sandcastle", "--state", "open", "--limit", "50", "--json", "number,title,body,labels,assignees"];
export function fetchQueueJson(gh: HostGh): string {
  const rows = JSON.parse(gh(QUEUE_ARGS)) as Array<{ number: number; title: string; labels: Array<{ name: string }>; assignees: unknown[] }>;
  return JSON.stringify(rows.filter((r) => r.assignees.length === 0).map((r) => ({ number: r.number, title: r.title, labels: r.labels.map((l) => l.name) })));
}
export function fetchIssueJson(gh: HostGh, issue: number | string): string {
  return gh(["issue", "view", String(issue), "--json", "number,title,body,labels,comments"]).trim();
}

/** 单遍替换：票面正文里即使含 {{…}} 也不会被再次展开。 */
export function render(template: string, values: Record<string, string>): string {
  const out = template.replace(/\{\{([A-Z_]+)\}\}/g, (m, k: string) => (k in values ? values[k]! : m));
  return out;
}
const read = (name: string) => readFileSync(new URL(name, import.meta.url), "utf8");

export function renderImplementPrompt(issue: number | string, issueJson: string, template = read("./swarm-implement-prompt.md")): string {
  return render(template, { ISSUE_NUMBER: String(issue), ISSUE_JSON: issueJson });
}
export function renderPlanPrompt(queueJson: string, template = read("./swarm-plan-prompt.md")): string {
  return render(template, { QUEUE_JSON: queueJson });
}

/** 卡点回写：工蜂在阶段报告里写 status=blocked，卡点放 verification；宿主用现有 notify 通道回写票面。非 blocked 返回 null。 */
export function blockedNote(stdout: string): string | null {
  let report;
  try { report = parseStageReport(stdout); } catch { return null; }
  if (report.status !== "blocked") return null;
  return report.verification.join("\n").trim() || "（工蜂报告 blocked，未附说明）";
}
export function blockedComment(issue: number | string, note: string): string {
  return [`> *This was generated by AI (sandcastle main-swarm implementer, #1742).*`, ``, `实施工蜂报告 blocked（#${issue}）：`, ``, note].join("\n");
}

export interface ImplementerDeps {
  gh: HostGh;
  run: (o: { name: string; maxIterations: number; agent: unknown; prompt: string }) => Promise<{ stdout: string }>;
  agent: unknown;
  notify: (issue: number, body: string) => void;
}
/** 实施工蜂一次运行：宿主取票面 → inline prompt → 容器内只做编辑；blocked 由宿主回写票面。返回工蜂 stdout。 */
export async function runImplementer(issue: number | string, d: ImplementerDeps, template?: string): Promise<string> {
  const prompt = renderImplementPrompt(issue, fetchIssueJson(d.gh, issue), template);
  const { stdout } = await d.run({ name: "implementer", maxIterations: 1, agent: d.agent, prompt });
  const note = blockedNote(stdout);
  if (note !== null) d.notify(Number(issue), blockedComment(issue, note));
  return stdout;
}
