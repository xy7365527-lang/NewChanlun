+	return host.invite({
+		parentSessionId: PARENT_SESSION_ID,
+		parentSessionFile: PARENT_SESSION_FILE,
+		depth: 0,
+		name: "remote-worker",
+		workload,
+	});
+}
+
+async function admitWorker(
+	host: RemoteChildAdmissionHost,
