  "sources": [{"id":"coverage","revision":"6f99b36c64e0560febdb08e5d1f8e781d2af9299","path":".chanlun/review-results/issue1339-r2-spec-20260909/payload/spec/inputs/SPEC-COVERAGE-INPUT.json","sha256":"76019aba67712e9140a95f8eaf2495a9b745707fce1ce5684de7df4334fa2b4c","bytes":1298462,"usedLocations":["/requirements/3 (ST-004)","/requirements/4 (ST-005)","/classification_axes/7 (CC-008)","/classification_axes/8 (CC-009)","/classification_axes/9 (CC-010)","/classification_axes/54 (CC-055)","/classification_axes/55 (CC-056)","/legal_combination_contracts/1 (LC-02)","仅原始见证前件：/requirements/1, /requirements/2 的criterion_or_requirement"]},{"id":"approval","revision":"6f99b36c64e0560febdb08e5d1f8e781d2af9299","path":".chanlun/review-results/issue1339-r2-spec-20260909/APPROVAL.json","sha256":"1469f209c78209f9ea33683e1b4209e0c75839f8a6802b5f56a4fc6019121d89","bytes":1086,"usedLocations":["签署范围及已批准SPEC SHA"]},{"id":"interface","revision":"6f99b36c64e0560febdb08e5d1f8e781d2af9299","path":".chanlun/review-results/issue1339-r2-spec-20260909/payload/spec/INTERFACE-CONTRACTS.md","sha256":"f1a2993c6fa4c6c29c6b9a4de7c1d0334c697aaa03e282f621171c37fc01d0e7","bytes":10889,"usedLocations":["行7–13：身份、精确数值和真实时间","行19–23：输入/结构发布/Snapshot/Watch","行43–45：StructureRecord/Delta","行60–64：恢复和验收边界"]},{"id":"inclusion","revision":"6f99b36c64e0560febdb08e5d1f8e781d2af9299","path":".chanlun/definitions/baohan.md","sha256":"73a895bdaf196efc6e81183518a8395a3548101fda3cf1a68465d1595da7203f","bytes":10279,"usedLocations":["行88–104、119–131：包含、方向与左折叠","行144–147：组锚及成员映射"]},{"id":"fractal","revision":"6f99b36c64e0560febdb08e5d1f8e781d2af9299","path":".chanlun/definitions/fenxing.md","sha256":"0285fd9d9352b63a6ec1686bd5d7543dcd2a7c2d93c9a2e47d007507fc58f88f","bytes":8003,"usedLocations":["行92–126：包含后严格双条件分型"]},{"id":"stroke","revision":"6f99b36c64e0560febdb08e5d1f8e781d2af9299","path":".chanlun/definitions/bi.md","sha256":"b4a0497ed0487a9d63fb239d20a4b564b6fbc8aa239b2abee7f18c895feb0a4b","bytes":40936,"usedLocat