{"signifier_id": "Aufhebung", "lang": "de", "morphemes": [{"form": "Auf", "meaning": "向上/打开", "shared_with": ["Aufklärung"]}, {"form": "Hebung", "meaning": "举起/提升", "shared_with": []}], "etymology": "日常三义：取消(aufheben=收起不用)/保存(aufheben=保管)/提升(aufheben=举高)。黑格尔利用此三义表达辩证运动：否定+保留+提升同时发生"}
{"signifier_id": "Selbstbewusstsein", "lang": "de", "morphemes": [{"form": "Selbst", "meaning": "自己/自身", "shared_with": ["Selbstbestimmung"]}, {"form": "Bewusst", "meaning": "意识到的/知觉到的", "shared_with": []}, {"form": "Sein", "meaning": "存在/是", "shared_with": ["Dasein", "Fürsichsein", "Ansichsein"]}], "etymology": "自我+意识+存在。黑格尔《精神现象学》核心概念：意识将自身作为对象来认识，自我在认识他者中回返自身"}
{"signifier_id": "Gegenstand", "lang": "de", "morphemes": [{"form": "Gegen", "meaning": "对面/反对", "shared_with": []}, {"form": "Stand", "meaning": "站立/位置", "shared_with": ["Vorstellung", "Gegenstand"]}], "etymology": "对面站着的东西。德语中'对象'的日常含义直接揭示了认识论结构：对象是站在主体对面的存在者"}
{"signifier_id": "Widerspruch", "lang": "de", "morphemes": [{"form": "Wider", "meaning": "反对/相反", "shared_with": []}, {"form": "Spruch", "meaning": "言说/判断", "shared_with": []}], "etymology": "反着说/反驳。矛盾=言说与反言说的对立。黑格尔将矛盾从形式逻辑的禁忌提升为辩证运动的核心驱动力"}
{"signifier_id": "Vorstellung", "lang": "de", "morphemes": [{"form": "Vor", "meaning": "在前/之前", "shared_with": ["Vorhandenheit"]}, {"form": "Stellung", "meaning": "放置/位置", "shared_with": []}], "etymology": "放在前面的东西。表象=心灵将内容摆放在自己面前来观看。黑格尔区分Vorstellung(表象思维=图像式)与Begriff(概念思维=思辨式)"}
{"signifier_id": "Wirklichkeit", "lang": "de", "morphemes": [{"form": "Wirk", "meaning": "作用/工作/产生效果", "shared_with": ["Wechselwirkung"]}, {"form": "lich", "meaning": "形容词后缀(具有...性质的)", "shared_with": ["Innerweltlichkeit", "Uneigentlichkeit", "Nachträglichkeit"]}, {"form": "keit", "meaning": "名词后缀(状态/性质)", "shared_with": ["Bestimmtheit", "Zuhandenheit", "Vorhandenheit", "Geworfenheit", "Innerweltlichkeit", "Uneigentlichkeit", "Nachträglichkeit"]}], "etymology": "有作用的状态/产生效果的状态。德语'现实'不是静态的'实在'，而是正在起作用(wirken)的东西。黑格尔：现实性=本质与存在的统一"}
{"signifier_id": "Entfremdung", "lang": "de", "morphemes": [{"form": "Ent", "meaning": "离开/脱离(表分离)", "shared_with": []}, {"form": "Fremd", "meaning": "陌生的/外来的", "shared_with": []}, {"form": "ung", "meaning": "名词后缀(过程/动作)", "shared_with": ["Verdrängung", "Verneinung", "Umwertung", "Vergesellschaftung", "Selbstbestimmung", "Aufklärung", "Wechselwirkung"]}], "etymology": "变得陌生的过程。异化=本属于自身的东西变为陌生的外在之物。黑格尔用于精神的外化，马克思用于劳动的异化"}
{"signifier_id": "Bestimmtheit", "lang": "de", "morphemes": [{"form": "Be", "meaning": "使动前缀(使成为...)", "shared_with": ["Selbstbestimmung"]}, {"form": "Stimmt", "meaning": "确定的/调和的", "shared_with": ["Selbstbestimmung"]}, {"form": "heit", "meaning": "名词后缀(状态/性质)", "shared_with": ["Zuhandenheit", "Vorhandenheit", "Geworfenheit", "Wirklichkeit"]}], "etymology": "被规定了的状态。规定性=一事物区别于他事物的确定特征。黑格尔：omnis determinatio est negatio(一切规定都是否定)"}
{"signifier_id": "Selbstbestimmung", "lang": "de", "morphemes": [{"form": "Selbst", "meaning": "自身/自己", "shared_with": ["Selbstbewusstsein"]}, {"form": "Bestimmung", "meaning": "规定/使命/命运", "shared_with": ["Bestimmtheit"]}], "etymology": "自我规定。自由的核心含义：不被外在力量规定，而是自己规定自己。黑格尔：概念的自我展开就是自我规定"}
{"signifier_id": "Aufklärung", "lang": "de", "morphemes": [{"form": "Auf", "meaning": "向上/打开/使明亮", "shared_with": ["Aufhebung"]}, {"form": "Klärung", "meaning": "澄清/使清楚", "shared_with": []}], "etymology": "使之明亮/使之清澈。启蒙=用理性之光驱散蒙昧。德语词源直接传达了'光→明→知'的隐喻链"}
{"signifier_id": "Erscheinung", "lang": "de", "morphemes": [{"form": "Er", "meaning": "出/使动前缀(表完成或产生)", "shared_with": []}, {"form": "Scheinung", "meaning": "显现/照射", "shared_with": []}], "etymology": "显现出来的东西。现象=从隐蔽中走出来呈现自身。黑格尔区分Erscheinung(现象=本质的显现)与Schein(假象=无根据的显现)"}
{"signifier_id": "Dasein", "lang": "de", "morphemes": [{"form": "Da", "meaning": "此处/那里", "shared_with": []}, {"form": "Sein", "meaning": "存在/是", "shared_with": ["Selbstbewusstsein", "Fürsichsein", "Ansichsein"]}], "etymology": "在此处的存在。黑格尔：定在=具有规定性的存在(质的存在)。海德格尔重新征用为'此在'：人=在那里存在的存在者，存在在此(Da)展开"}
{"signifier_id": "Fürsichsein", "lang": "de", "morphemes": [{"form": "Für", "meaning": "为了/对于", "shared_with": []}, {"form": "Sich", "meaning": "自己(反身代词)", "shared_with": ["Ansichsein"]}, {"form": "Sein", "meaning": "存在/是", "shared_with": ["Selbstbewusstsein", "Dasein", "Ansichsein"]}], "etymology": "为自己而存在。自为存在=回返自身的存在，已完成对他者的否定而回到自身。与自在(Ansich)构成辩证对：自在=潜在/未展开，自为=展开/实现"}
{"signifier_id": "Ansichsein", "lang": "de", "morphemes": [{"form": "An", "meaning": "在/依附/就其本身", "shared_with": []}, {"form": "Sich", "meaning": "自己(反身代词)", "shared_with": ["Fürsichsein"]}, {"form": "Sein", "meaning": "存在/是", "shared_with": ["Selbstbewusstsein", "Dasein", "Fürsichsein"]}], "etymology": "就其自身而言的存在。自在存在=尚未展开的潜在状态。康德的'物自体'(Ding an sich)中的an sich同源。黑格尔：自在是尚未为自身所知的东西"}
{"signifier_id": "Gebrauchswert", "lang": "de", "morphemes": [{"form": "Gebrauch", "meaning": "使用/用途", "shared_with": []}, {"form": "Wert", "meaning": "价值/值", "shared_with": ["Tauschwert", "Mehrwert", "Umwertung"]}], "etymology": "使用价值。商品的质的方面：通过物理属性满足特定需要。马克思：使用价值是交换价值的物质承担者"}
{"signifier_id": "Tauschwert", "lang": "de", "morphemes": [{"form": "Tausch", "meaning": "交换/互换", "shared_with": []}, {"form": "Wert", "meaning": "价值/值", "shared_with": ["Gebrauchswert", "Mehrwert", "Umwertung"]}], "etymology": "交换价值。商品的量的方面：一种使用价值与另一种使用价值相交换的比例关系。是价值(抽象劳动)的表现形式"}
{"signifier_id": "Mehrwert", "lang": "de", "morphemes": [{"form": "Mehr", "meaning": "更多/额外", "shared_with": []}, {"form": "Wert", "meaning": "价值/值", "shared_with": ["Gebrauchswert", "Tauschwert", "Umwertung"]}], "etymology": "更多的价值/多出的价值。剩余价值=劳动力所创造的价值超出劳动力自身价值的部分。资本主义剥削的核心范畴"}
{"signifier_id": "Arbeitskraft", "lang": "de", "morphemes": [{"form": "Arbeit", "meaning": "劳动/工作", "shared_with": []}, {"form": "Kraft", "meaning": "力/力量/能力", "shared_with": []}], "etymology": "劳动力。马克思的关键区分：Arbeit(劳动=活动过程) vs Arbeitskraft(劳动力=被购买和消耗的商品)。资本家购买的不是劳动而是劳动力"}
{"signifier_id": "Verdinglichung", "lang": "de", "morphemes": [{"form": "Ver", "meaning": "使成为(使动前缀)", "shared_with": ["Verdrängung", "Verneinung", "Vergesellschaftung"]}, {"form": "Ding", "meaning": "物/事物", "shared_with": []}, {"form": "lichung", "meaning": "形容词化+名词化复合后缀", "shared_with": []}], "etymology": "使成为物的过程。物化=社会关系呈现为物与物的关系。卢卡奇发展马克思的商品拜物教：人的活动和关系凝固为独立的物的属性"}
{"signifier_id": "Warenfetischismus", "lang": "de", "morphemes": [{"form": "Waren", "meaning": "商品(复数)", "shared_with": []}, {"form": "Fetischismus", "meaning": "拜物教/恋物", "shared_with": []}], "etymology": "商品拜物教。马克思《资本论》第一卷第一章：商品形式使人与人的社会关系呈现为物与物的关系，商品仿佛具有超自然的神秘力量"}
{"signifier_id": "Überbau", "lang": "de", "morphemes": [{"form": "Über", "meaning": "上方/超越", "shared_with": ["Übermensch"]}, {"form": "Bau", "meaning": "建筑/结构", "shared_with": []}], "etymology": "上方的建筑。上层建筑=建立在经济基础(Basis)之上的政治、法律、意识形态等制度。马克思的基础-上层建筑隐喻"}
{"signifier_id": "Zuhandenheit", "lang": "de", "morphemes": [{"form": "Zu", "meaning": "向/到(表方向和亲近)", "shared_with": []}, {"form": "Hand", "meaning": "手", "shared_with": ["Vorhandenheit"]}, {"form": "en", "meaning": "连接词素", "shared_with": ["Vorhandenheit"]}, {"form": "heit", "meaning": "名词后缀(状态)", "shared_with": ["Vorhandenheit", "Geworfenheit", "Bestimmtheit", "Wirklichkeit"]}], "etymology": "到手边的状态/上手状态。海德格尔：工具在使用中不被注意地顺手(zuhanden)，此时工具'退隐'而非成为观察对象。与Vorhandenheit(在手状态)对立"}
{"signifier_id": "Vorhandenheit", "lang": "de", "morphemes": [{"form": "Vor", "meaning": "在前/面前", "shared_with": ["Vorstellung"]}, {"form": "Hand", "meaning": "手", "shared_with": ["Zuhandenheit"]}, {"form": "en", "meaning": "连接词素", "shared_with": ["Zuhandenheit"]}, {"form": "heit", "meaning": "名词后缀(状态)", "shared_with": ["Zuhandenheit", "Geworfenheit", "Bestimmtheit", "Wirklichkeit"]}], "etymology": "在手前面的状态/在手状态。海德格尔：事物作为纯粹观察对象在眼前呈现，脱离了实践关联。科学的理论态度将一切视为vorhanden"}
{"signifier_id": "Geworfenheit", "lang": "de", "morphemes": [{"form": "Ge", "meaning": "被(过去分词前缀)", "shared_with": []}, {"form": "Worfen", "meaning": "投掷(werfen的过去分词词干)", "shared_with": []}, {"form": "heit", "meaning": "名词后缀(状态)", "shared_with": ["Zuhandenheit", "Vorhandenheit", "Bestimmtheit", "Wirklichkeit"]}], "etymology": "被投掷的状态。被抛性=此在总已经被抛入一个非自己选择的处境(时代、身体、语言、文化)。存在先于本质：人先存在，再规定自己"}
{"signifier_id": "Innerweltlichkeit", "lang": "de", "morphemes": [{"form": "Inner", "meaning": "内部/里面", "shared_with": []}, {"form": "Welt", "meaning": "世界", "shared_with": []}, {"form": "lich", "meaning": "形容词后缀", "shared_with": ["Wirklichkeit", "Uneigentlichkeit", "Nachträglichkeit"]}, {"form": "keit", "meaning": "名词后缀(状态)", "shared_with": ["Wirklichkeit", "Uneigentlichkeit", "Nachträglichkeit", "Bestimmtheit"]}], "etymology": "在世界之内的状态。世内性=存在者在世界之内被照面的方式。海德格尔区分：世界(Welt)=此在的存在论结构，世内(innerweltlich)=在世界中遭遇的存在者"}
{"signifier_id": "Uneigentlichkeit", "lang": "de", "morphemes": [{"form": "Un", "meaning": "否定前缀(非/不)", "shared_with": []}, {"form": "Eigent", "meaning": "本己的/本真的(eigen=自己的)", "shared_with": []}, {"form": "lich", "meaning": "形容词后缀", "shared_with": ["Wirklichkeit", "Innerweltlichkeit", "Nachträglichkeit"]}, {"form": "keit", "meaning": "名词后缀(状态)", "shared_with": ["Wirklichkeit", "Innerweltlichkeit", "Nachträglichkeit", "Bestimmtheit"]}], "etymology": "非本己的状态。非本真性=此在沉沦于常人(das Man)的日常存在方式。海德格尔：非本真不是贬义的道德判断，而是此在的首先和通常的存在方式"}
{"signifier_id": "Übermensch", "lang": "de", "morphemes": [{"form": "Über", "meaning": "超越/在上方", "shared_with": ["Überbau"]}, {"form": "Mensch", "meaning": "人/人类", "shared_with": []}], "etymology": "超越人的存在。超人=克服了末人(letzter Mensch)的虚无主义、能够自我立法创造新价值的人。尼采：人是从动物到超人之间的一条绳索"}
{"signifier_id": "Umwertung", "lang": "de", "morphemes": [{"form": "Um", "meaning": "转变/颠倒/重新", "shared_with": []}, {"form": "Wertung", "meaning": "评价/估价", "shared_with": ["Gebrauchswert", "Tauschwert", "Mehrwert"]}], "etymology": "重新评价/价值转换。尼采'一切价值的重估'(Umwertung aller Werte)：不是在旧价值体系内调整，而是颠覆价值评判的标准本身"}
{"signifier_id": "Wiederkunft", "lang": "de", "morphemes": [{"form": "Wieder", "meaning": "再次/重新", "shared_with": []}, {"form": "Kunft", "meaning": "来到/到来(kommen的名词化)", "shared_with": []}], "etymology": "再次到来/永恒回归。尼采的永恒轮回(ewige Wiederkunft des Gleichen)：同一者的永恒再来。最沉重的思想：如果一切永恒重复，你还愿意如此生活吗？"}
{"signifier_id": "Verdrängung", "lang": "de", "morphemes": [{"form": "Ver", "meaning": "使动前缀(表完成/彻底)", "shared_with": ["Verdinglichung", "Verneinung", "Vergesellschaftung"]}, {"form": "Drängung", "meaning": "推挤/压迫(drängen的名词化)", "shared_with": []}], "etymology": "彻底推走的过程。压抑=将不可接受的表象(Vorstellung)从意识推入无意识。弗洛伊德：压抑不是消除，被压抑物持续产生效果并以症状形式回返"}
{"signifier_id": "Verneinung", "lang": "de", "morphemes": [{"form": "Ver", "meaning": "使动前缀(表完成)", "shared_with": ["Verdinglichung", "Verdrängung", "Vergesellschaftung"]}, {"form": "Neinung", "meaning": "否认/说不(neinen的名词化)", "shared_with": []}], "etymology": "否定/否认。弗洛伊德(1925)同名论文：否定是压抑的智识替代——被分析者说'这不是我母亲'恰恰泄露了这就是母亲。否定的形式允许被压抑内容进入意识"}
{"signifier_id": "Nachträglichkeit", "lang": "de", "morphemes": [{"form": "Nach", "meaning": "之后/随后", "shared_with": []}, {"form": "Träglich", "meaning": "携带的/承载的(tragen的形容词化)", "shared_with": []}, {"form": "keit", "meaning": "名词后缀(状态)", "shared_with": ["Wirklichkeit", "Innerweltlichkeit", "Uneigentlichkeit", "Bestimmtheit"]}], "etymology": "事后才携带意义的状态。事后性/追溯性=早期经验在后来获得创伤性意义。弗洛伊德：创伤不在事件发生时产生，而在第二个事件追溯性地激活第一个事件时产生"}
{"signifier_id": "Triebschicksal", "lang": "de", "morphemes": [{"form": "Trieb", "meaning": "驱力/冲动(treiben=驱动)", "shared_with": []}, {"form": "Schicksal", "meaning": "命运/天命(schicken=送出)", "shared_with": []}], "etymology": "驱力的命运。弗洛伊德(1915)《驱力及其命运》：驱力的四种命运——转向对立面、转向自身、压抑、升华。驱力不可消除，只能改变走向"}
{"signifier_id": "Fehlleistung", "lang": "de", "morphemes": [{"form": "Fehl", "meaning": "错误/失误(fehlen=缺失)", "shared_with": []}, {"form": "Leistung", "meaning": "行为/成就/表现", "shared_with": []}], "etymology": "错误的行为/失败的表现。过失行为=口误、笔误、遗忘、误读等。弗洛伊德：Fehlleistung不是单纯的失误，而是无意识愿望的成功表达——在意识看来是失败，在无意识看来是成就"}
{"signifier_id": "Wechselwirkung", "lang": "de", "morphemes": [{"form": "Wechsel", "meaning": "交换/交替/变化", "shared_with": []}, {"form": "Wirkung", "meaning": "作用/效果(wirken的名词化)", "shared_with": ["Wirklichkeit"]}], "etymology": "交互作用/相互影响。西美尔社会学核心概念：社会不是实体而是过程——个体之间持续的交互作用(Wechselwirkung)构成了社会的存在方式"}
{"signifier_id": "Vergesellschaftung", "lang": "de", "morphemes": [{"form": "Ver", "meaning": "使成为(使动前缀)", "shared_with": ["Verdinglichung", "Verdrängung", "Verneinung"]}, {"form": "Gesellschaft", "meaning": "社会/共同体", "shared_with": []}, {"form": "ung", "meaning": "名词后缀(过程)", "shared_with": ["Entfremdung", "Verdrängung", "Verneinung", "Umwertung"]}], "etymology": "使之成为社会的过程。社会化=个体被编入社会关系网络的动态过程。西美尔：重点不在结果(社会)而在过程(社会化)——社会在持续的社会化中不断生成"}
